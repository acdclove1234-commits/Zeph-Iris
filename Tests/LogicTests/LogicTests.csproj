<Project Sdk="Microsoft.NET.Sdk">
  <!-- ロジックテスト（画面・ハードウェアを使わない部分だけ）。実行: dotnet run (Tests/LogicTests フォルダーで。引数に名前の一部を渡すと絞り込み) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>CA1416;CS8321</NoWarn>
    <RootNamespace>LogicTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(NuGetPackageRoot)librehardwaremonitorlib/0.9.6/runtimes/win-x64/lib/net8.0/LibreHardwareMonitorLib.dll" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../Core/**/*.cs" Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- 拍の AI（Core/Audio/BeatThis.cs）: 本体と同じ ONNX Runtime・NAudio の変換器・埋め込みモデル -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <EmbeddedResource Include="../../Assets/Models/*.onnx" LogicalName="ProFanController.Models.%(Filename).onnx" />
  </ItemGroup>
</Project>
