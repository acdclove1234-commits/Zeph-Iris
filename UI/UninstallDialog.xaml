<!-- ==================================================
     UninstallDialog.xaml - アンインストール（お片付け）の確認と進み具合 (行うことを順番に並べ、選んだあとに 1 つずつ行う)
     Dependencies: WPF / .NET 8 (MIT License)
     See CREDITS.txt for full license details.
     ================================================== -->
<Window x:Class="ProFanController.UI.UninstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="アンインストール（お片付け） - Fanlume" Width="820" Height="720" MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFont}" FontSize="14" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" FontWeight="Medium">
    <Window.Resources>
        <DataTemplate x:Key="StepTemplate">
            <Border Background="{DynamicResource InputBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" FontWeight="Bold" FontSize="15" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="20"/>
                        <TextBlock Text="{Binding Detail}" Foreground="{Binding GlyphBrush}" Style="{StaticResource Caption}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding DetailVisibility}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="32,26,32,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="アンインストール（お片付け）" Style="{StaticResource H1}"/>
            <TextBlock x:Name="IntroText" Style="{StaticResource Caption}" FontSize="14" Margin="0,6,0,14" TextWrapping="Wrap" LineHeight="22"
                       Text="Fanlume を使うのをやめる前に、PC をこのアプリを入れる前の状態に戻します。「お片付けして終了する」を押すと、次のことを上から順に行います。"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl x:Name="StepList" ItemTemplate="{StaticResource StepTemplate}"/>

                <Border x:Name="OptionsCard" Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="あわせて行うこと（どちらも、選ばなければ行いません）" Style="{StaticResource H2}"/>
                        <CheckBox x:Name="DeleteDataSwitch" Style="{StaticResource Switch}" Margin="0,14,0,0" Click="OnOptionChanged">
                            <StackPanel>
                                <TextBlock Text="設定・ログ・記録も消す" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DeleteDataCaption" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="PawnIoSwitch" Style="{StaticResource Switch}" Margin="0,16,0,0" Click="OnOptionChanged">
                            <StackPanel>
                                <TextBlock Text="PawnIO（ファン制御用のドライバー）もアンインストールする" FontWeight="SemiBold"/>
                                <TextBlock x:Name="PawnIoCaption" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Text="winget でアンインストールします。FanControl・LibreHardwareMonitor・OpenRGB など、ほかのソフトも PawnIO を使っていることがあります。それらを使い続けるなら、オフのままにしてください。"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="FolderNote" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,12,0,0" LineHeight="20"/>

                <Border x:Name="SummaryCard" Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="SummaryText" TextWrapping="Wrap" LineHeight="22"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Content="キャンセル" Click="OnCancelClick" MinWidth="110"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="StartButton" Style="{StaticResource DangerButton}" Content="お片付けして終了する" Click="OnStartClick" MinWidth="180"/>
                <Button x:Name="CloseButton" Style="{StaticResource AccentButton}" Content="閉じて終了する" Click="OnCloseClick" MinWidth="160" Visibility="Collapsed"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
