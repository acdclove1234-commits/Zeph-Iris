<!-- ==================================================
     RemapDialog.xaml - センサー・端子の対応付け画面 (部品の交換を検知したとき・設定ファイルを読み込むときに共通で使う)
     Dependencies: WPF / .NET 8 (MIT License)
     See CREDITS.txt for full license details.
     ================================================== -->
<Window x:Class="ProFanController.UI.RemapDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fanlume" Width="860" Height="680" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFont}" FontSize="14" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" FontWeight="Medium">
    <Window.Resources>
        <DataTemplate x:Key="RowTemplate">
            <Border Background="{DynamicResource InputBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Item.OldDisplay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding UsageText}" Style="{StaticResource Caption}" FontSize="12" TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" ToolTip="{Binding UsageText}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="&#xE72A;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Accent2Brush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <ComboBox ItemsSource="{Binding Options}" DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding Choice}"/>
                        <TextBlock Text="{Binding Item.Note}" Style="{StaticResource Caption}" FontSize="12" Margin="2,4,0,0"
                                   Foreground="{Binding NoteBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="32,26,32,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentGradient}" Margin="0,0,14,0">
                    <TextBlock x:Name="HeaderIcon" Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TitleText" Style="{StaticResource H1}" FontSize="22" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="SubText" Style="{StaticResource Caption}" FontSize="14" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="21"/>
        </StackPanel>

        <!-- 部品の変化 / 読み込みの設定 -->
        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <Border x:Name="ChangesCard" Background="{DynamicResource AccentTintBrush}" BorderBrush="{DynamicResource AccentLineBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10"
                    Margin="0,0,0,10" Visibility="Collapsed">
                <ItemsControl x:Name="ChangesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontWeight="SemiBold" Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <Border x:Name="ImportCard" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="ImportSource" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                    <TextBlock Text="読み込むプロファイル" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                    <ItemsControl x:Name="ProfilePicks">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Selected}" Content="{Binding Name}" Margin="0,4,20,4"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <CheckBox x:Name="ReplaceSwitch" Style="{StaticResource Switch}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="同じ名前のプロファイルは置き換える" FontWeight="SemiBold"/>
                            <TextBlock Text="オフのときは「標準（読み込み）」のような名前で追加します（今の設定は残ります）" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
            <StackPanel Margin="0,0,8,0">
                <StackPanel x:Name="ControlSection">
                    <TextBlock Text="ファン端子" Style="{StaticResource H2}" Margin="0,4,0,8"/>
                    <ItemsControl x:Name="ControlRows" ItemTemplate="{StaticResource RowTemplate}"/>
                </StackPanel>
                <StackPanel x:Name="SensorSection">
                    <TextBlock Text="温度センサー" Style="{StaticResource H2}" Margin="0,10,0,8"/>
                    <ItemsControl x:Name="SensorRows" ItemTemplate="{StaticResource RowTemplate}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <Button x:Name="WizardButton" DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="セットアップウィザードで最初から設定する"
                    Click="OnWizardClick" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Content="あとで" Click="OnCancelClick" Margin="0,0,8,0" MinWidth="96"/>
                <Button x:Name="ApplyButton" Style="{StaticResource AccentButton}" Content="置き換えて適用" Click="OnApplyClick" MinWidth="150"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
