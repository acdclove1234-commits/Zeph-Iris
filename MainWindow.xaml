<!-- ==================================================
     MainWindow.xaml - メイン画面 (ダッシュボード / デバイス / ファンカーブ / 履歴 / レポート / 診断 /
                       テスト・調整 / ライティング / センサー / 設定)
     Dependencies: WPF / .NET 8 (MIT License)
     See CREDITS.txt for full license details.
     ================================================== -->
<Window x:Class="ProFanController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:ProFanController.UI.Controls"
        xmlns:ui="clr-namespace:ProFanController.UI"
        Title="ProFanController" Width="1360" Height="900" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFont}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" FontWeight="Medium"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <ui:EqualsConverter x:Key="Equals"/>

        <!-- 制御モードごとに表示するパネル -->
        <Style x:Key="TargetOnly" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Mode}" Value="Target">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FollowOnly" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Mode}" Value="Follow">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ポンプのときだけ表示する項目 -->
        <Style x:Key="PumpOnly" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPump}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- ファンのときだけ表示する項目 -->
        <Style x:Key="FanOnly" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPump}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- カーブモードのときだけカーブ編集を表示 -->
        <Style x:Key="CurveOnly" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Mode}" Value="Curve">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- GPU のファンのときだけ表示 -->
        <Style x:Key="GpuOnly" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGpuFan}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 通知の方法ごとに表示する設定 -->
        <Style x:Key="NtfyOnly" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Notify.Service}" Value="Discord">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DiscordOnly" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Notify.Service}" Value="Discord">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource AccentGradient}"/>
        </Style>
        <!-- LED の光り方ごとに表示する設定 -->
        <Style x:Key="RgbTempOnly" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Rgb.Mode}" Value="Temperature">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RgbMusicOnly" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Rgb.Mode}" Value="Music">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SmallGhost" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- ===== ライティング画面 ===== -->
        <!-- 1 行の設定（左に名前、右に値、間にスライダーなど）。行ごと隠せるように DockPanel で作る -->
        <Style x:Key="LightRow" TargetType="DockPanel">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="LastChildFill" Value="True"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Width" Value="170"/>
            <Setter Property="DockPanel.Dock" Value="Left"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- チップの並びの左の名前（上にそろえる） -->
        <Style x:Key="RowLabelTop" TargetType="TextBlock" BasedOn="{StaticResource RowLabel}">
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
        <Style x:Key="RowValue" TargetType="TextBlock" BasedOn="{StaticResource Value}">
            <Setter Property="Width" Value="84"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="DockPanel.Dock" Value="Right"/>
        </Style>
        <!-- 選択肢のチップ（プリセット・強さ・パレット・テンポなど）。選ばれているもの（IsSelected）は色が付く -->
        <Style x:Key="ChoiceChip" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource InputBrush}" CornerRadius="14" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TrackBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentGradient}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 音楽の表現のギャラリー（名前と説明のカード） -->
        <Style x:Key="EffectTile" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="92"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="2" CornerRadius="12" Padding="12,9">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MutedBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- オン・オフで色が変わるボタン（同期テスト・詳しい設定） -->
        <Style x:Key="ToggleChip" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentGradient}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- デバイスのチェック（「すべてのデバイス」のときは押せないので、薄く表示する） -->
        <Style x:Key="DeviceCheck" TargetType="CheckBox" BasedOn="{StaticResource Check}">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 小さな印（「更新が遅いデバイス」など） -->
        <Style x:Key="SoftBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource WarnFillBrush}"/>
        </Style>

        <DataTemplate x:Key="ChoiceChipTemplate">
            <Button Style="{StaticResource ChoiceChip}" Click="OnLightingChoiceClick" IsEnabled="{Binding IsEnabled}" ToolTip="{Binding Tip}">
                <TextBlock Text="{Binding Label}"/>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="PaletteChipTemplate">
            <Button Style="{StaticResource ChoiceChip}" Click="OnLightingChoiceClick" ToolTip="{Binding Tip}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="46" Height="12" CornerRadius="6" Background="{Binding Swatch}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="EffectTileTemplate">
            <Button Style="{StaticResource EffectTile}" Click="OnLightingChoiceClick" IsEnabled="{Binding IsEnabled}" ToolTip="{Binding Tip}">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" FontSize="12" Margin="0,3,0,0"
                               MaxHeight="44" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Warning}" FontSize="12" Foreground="{DynamicResource WarnBrush}" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Button>
        </DataTemplate>
        <!-- 色の候補（選ばれている色には白い輪を付ける） -->
        <DataTemplate x:Key="SwatchTemplate">
            <Button Click="OnLightingChoiceClick" Cursor="Hand" Margin="0,0,4,0" ToolTip="{Binding Tip}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="30" Height="30" Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource MutedBrush}" StrokeThickness="2" Visibility="Collapsed"/>
                            <Ellipse Width="22" Height="22" Fill="{Binding Swatch}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource TextBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
        <!-- 背景色の候補: 角の丸い四角を、色合いと濃さが分かる色で塗る -->
        <DataTemplate x:Key="BackgroundSwatchTemplate">
            <Button Click="OnLightingChoiceClick" Cursor="Hand" Margin="0,0,4,4" ToolTip="{Binding Tip}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="34" Height="30" Background="Transparent">
                            <Border x:Name="Ring" CornerRadius="8" BorderBrush="{DynamicResource MutedBrush}" BorderThickness="2" Visibility="Collapsed"/>
                            <Border Width="28" Height="24" CornerRadius="6" Background="{Binding Swatch}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource TextBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= サイドバー ================= -->
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="24,28,0,30">
                    <Image x:Name="LogoImage" Width="34" Height="34"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ProFan" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="CONTROLLER" FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="1,-2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 動作状態と一時停止ボタン -->
                <Border DockPanel.Dock="Bottom" Margin="16,0,16,20" Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Text="初期化中…" Margin="8,0,0,0" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="StatusSub" Style="{StaticResource Caption}" Margin="0,6,0,12" Text="ハードウェアを検出しています"/>
                        <TextBlock x:Name="QuickStatusText" Style="{StaticResource Caption}" Foreground="{DynamicResource Accent2Brush}"
                                   FontWeight="SemiBold" Margin="0,-6,0,12" Visibility="Collapsed"/>
                        <Button x:Name="PauseButton" Style="{StaticResource GhostButton}" Content="一時停止（BIOS に戻す）"
                                Click="OnPauseClick" FontSize="13" Padding="10,7"/>
                    </StackPanel>
                </Border>

                <!-- プロファイル -->
                <Border DockPanel.Dock="Bottom" Margin="16,0,16,10" Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="プロファイル" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                        <ComboBox x:Name="SidebarProfileCombo" DisplayMemberPath="Name" SelectionChanged="OnSidebarProfileChanged"/>
                        <TextBlock x:Name="AutoSwitchText" Style="{StaticResource Caption}" Margin="0,8,0,0" Foreground="{DynamicResource Accent2Brush}"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- 画面の切り替え（ウィンドウが低いときはスクロールできるようにする） -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="0,0,0,10">
                    <StackPanel>
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}" Tag="&#xE80F;"
                                     Content="ダッシュボード" IsChecked="True" Checked="OnNavChanged"/>
                        <RadioButton x:Name="NavDevices" Style="{StaticResource NavItem}" Tag="&#xE772;"
                                     Content="デバイス" Checked="OnNavChanged"/>
                        <RadioButton x:Name="NavCurves" Style="{StaticResource NavItem}" Tag="&#xEC4A;"
                                     Content="ファンカーブ" Checked="OnNavChanged"/>
                        <RadioButton x:Name="NavHistory" Style="{StaticResource NavItem}" Tag="&#xE81C;"
                                     Content="履歴" Checked="OnNavChanged"/>
                        <RadioButton x:Name="NavReport" Style="{StaticResource NavItem}" Tag="&#xE9D2;"
                                     Content="レポート" Checked="OnNavChanged"/>
                        <RadioButton x:Name="NavTools" Style="{StaticResource NavItem}" Tag="&#xE946;"
                                     Content="診断" Checked="OnNavChanged"/>
                        <RadioButton x:Name="NavTest" Style="{StaticResource NavItem}" Tag="&#xE945;"
                                     Content="テスト・調整" Checked="OnNavChanged"/>
                        <RadioButton x:Name="NavLighting" Style="{StaticResource NavItem}" Tag="&#xE790;"
                                     Content="ライティング" Checked="OnNavChanged"/>
                        <RadioButton x:Name="NavSensors" Style="{StaticResource NavItem}" Tag="&#xE9D9;"
                                     Content="センサー" Checked="OnNavChanged"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="&#xE713;"
                                     Content="設定" Checked="OnNavChanged"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ================= コンテンツ ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="36,30,36,18">
                <!-- ページごとの操作ボタン -->
                <Grid DockPanel.Dock="Right" VerticalAlignment="Bottom">
                    <StackPanel x:Name="DashboardActions" Orientation="Horizontal">
                        <Button Style="{StaticResource AccentButton}" Click="OnBoostClick" Tag="5" Padding="14,7" Margin="0,0,8,0" ToolTip="ポンプ以外の全ファンを 5 分間 100% にします (Ctrl+Alt+B)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="ブースト 5分"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Click="OnQuietClick" Tag="60" Padding="14,7" Margin="0,0,8,0" ToolTip="静音プロファイルを 1 時間使います (Ctrl+Alt+Q)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE708;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="静音 1時間"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CancelQuickButton" Style="{StaticResource DangerButton}" Content="解除" Click="OnCancelQuickClick"
                                Padding="14,7" Margin="0,0,16,0" Visibility="Collapsed" ToolTip="ワンタッチ操作を解除 (Ctrl+Alt+N)"/>
                        <ToggleButton x:Name="EditCardsToggle" Content="カードを編集" Click="OnEditCardsClick" Margin="0,0,8,0"
                                      Foreground="{DynamicResource TextBrush}" Cursor="Hand">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="14,7">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentGradient}"/>
                                            <Setter TargetName="Bd" Property="BorderThickness" Value="0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Button Style="{StaticResource GhostButton}" Content="ミニウィジェット" Click="OnToggleWidgetClick" Padding="14,7"/>
                    </StackPanel>
                    <StackPanel x:Name="CurvesActions" Orientation="Horizontal" Visibility="Collapsed">
                        <Button x:Name="UndoButton" Style="{StaticResource GhostButton}" Click="OnUndoClick" Padding="12,7" Margin="0,0,8,0" ToolTip="元に戻す (Ctrl+Z)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="元に戻す"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="RedoButton" Style="{StaticResource GhostButton}" Click="OnRedoClick" Padding="12,7" ToolTip="やり直す (Ctrl+Y)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7A6;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="やり直す"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <!-- ライティングの元に戻す・やり直す（ファンの設定の履歴とは別。MainWindow.Lighting.cs） -->
                    <StackPanel x:Name="LightingActions" Orientation="Horizontal" Visibility="Collapsed">
                        <Button x:Name="LightingUndoButton" Style="{StaticResource GhostButton}" Click="OnLightingUndoClick" Padding="12,7" Margin="0,0,8,0" IsEnabled="False"
                                ToolTip="ライティングの設定を、ひとつ前に戻します (Ctrl+Z)。連携のオン・オフ、消灯、接続先、「激しい点滅を抑える」は変わりません">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="元に戻す"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="LightingRedoButton" Style="{StaticResource GhostButton}" Click="OnLightingRedoClick" Padding="12,7" IsEnabled="False"
                                ToolTip="元に戻したライティングの設定を、やり直します (Ctrl+Y)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7A6;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="やり直す"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel x:Name="HistoryActions" Orientation="Horizontal" Visibility="Collapsed">
                        <RadioButton Style="{StaticResource Segment}" Content="5分" Tag="5" GroupName="Range" Checked="OnRangeChanged"/>
                        <RadioButton Style="{StaticResource Segment}" Content="30分" Tag="30" GroupName="Range" Checked="OnRangeChanged" IsChecked="True"/>
                        <RadioButton Style="{StaticResource Segment}" Content="1時間" Tag="60" GroupName="Range" Checked="OnRangeChanged"/>
                        <RadioButton Style="{StaticResource Segment}" Content="6時間" Tag="360" GroupName="Range" Checked="OnRangeChanged"/>
                        <RadioButton Style="{StaticResource Segment}" Content="24時間" Tag="1440" GroupName="Range" Checked="OnRangeChanged" Margin="0,0,14,0"/>
                        <Button Style="{StaticResource AccentButton}" Content="CSV に書き出す" Click="OnExportCsvClick" Padding="14,7"/>
                    </StackPanel>
                </Grid>
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Style="{StaticResource H1}" Text="ダッシュボード"/>
                    <TextBlock x:Name="PageSubtitle" Style="{StaticResource Caption}" FontSize="14" Margin="0,4,0,0"
                               Text="温度とファンの状態をリアルタイムに表示します"/>
                </StackPanel>
            </DockPanel>

            <!-- 警告バナー -->
            <Border x:Name="AlertBanner" Grid.Row="1" Margin="36,0,36,16" CornerRadius="12" Padding="18,12"
                    Background="{DynamicResource DangerTintBrush}" BorderBrush="{DynamicResource DangerLineBrush}" BorderThickness="1" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;"
                            Foreground="{DynamicResource SubTextBrush}" Click="OnDismissAlert" ToolTip="閉じる"/>
                    <Button x:Name="AlertActionButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Padding="14,6" FontSize="13"
                            Margin="12,0,8,0" VerticalAlignment="Center" Click="OnAlertActionClick" Visibility="Collapsed"/>
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="18" x:Name="AlertIcon"
                               Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="AlertTitle" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock x:Name="AlertText" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ================= ダッシュボード ================= -->
            <ScrollViewer x:Name="DashboardPage" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="36,0,22,30">
                <StackPanel>
                    <ItemsControl x:Name="TempCards">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ctl:AdaptiveWrapPanel ItemMinWidth="258" ItemMaxWidth="400"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,14,14" Height="168">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel>
                                            <Ellipse DockPanel.Dock="Right" Width="8" Height="8" Fill="{Binding LevelBrush}" VerticalAlignment="Center"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding DisplaySubtitle}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                           ToolTip="{Binding SuspectReason}"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding ValueText}" Style="{StaticResource BigNumber}" Foreground="{Binding LevelBrush}"/>
                                            <TextBlock Text="°C" FontSize="16" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Bottom" Margin="4,0,0,8"/>
                                        </StackPanel>
                                        <ctl:Sparkline Grid.Row="2" Values="{Binding Values}" Stroke="{Binding LevelBrush}" Margin="0,6,0,0"/>
                                        <!-- 編集モード -->
                                        <Border Grid.RowSpan="3" Background="{DynamicResource ScrimBrush}" CornerRadius="10" Margin="-8"
                                                Visibility="{Binding Editing, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Style="{StaticResource GhostButton}" Content="&#xE76B;" FontFamily="{StaticResource IconFont}"
                                                        Tag="{Binding}" Click="OnMoveCardLeft" Margin="0,0,6,0" ToolTip="左へ"/>
                                                <Button Style="{StaticResource GhostButton}" Content="&#xE76C;" FontFamily="{StaticResource IconFont}"
                                                        Tag="{Binding}" Click="OnMoveCardRight" Margin="0,0,6,0" ToolTip="右へ"/>
                                                <Button Style="{StaticResource DangerButton}" Content="&#xE74D;" FontFamily="{StaticResource IconFont}"
                                                        Tag="{Binding}" Click="OnRemoveCard" ToolTip="削除"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="AddCardPanel" Style="{StaticResource Card}" Margin="0,0,14,14" Padding="16" Visibility="Collapsed">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="カードを追加" Click="OnAddCardClick" Margin="10,0,0,0"/>
                            <TextBlock DockPanel.Dock="Left" Text="表示する温度" Style="{StaticResource Label}" Margin="0,0,14,0"/>
                            <ComboBox x:Name="AddCardCombo" DisplayMemberPath="Display"/>
                        </DockPanel>
                    </Border>

                    <!-- システム（使用率・電力・メモリ・SSD） -->
                    <ItemsControl x:Name="MetricTiles">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ctl:AdaptiveWrapPanel ItemMinWidth="258" ItemMaxWidth="400"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,14,14" Padding="18,14">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}" FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        <TextBlock Text="{Binding ValueText}" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding SubText}" Style="{StaticResource Caption}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        <ctl:Sparkline Height="28" Values="{Binding Values}" Stroke="{Binding Brush}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- リアルタイムグラフ -->
                    <Border Style="{StaticResource Card}" Margin="0,0,14,14">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="直近 10 分 ／ 実線 = 温度（左軸） ・ 破線 = 回転数（右軸）" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                <TextBlock Text="リアルタイム" Style="{StaticResource H2}"/>
                            </DockPanel>
                            <ctl:HistoryChart x:Name="LiveChart" Height="250" Margin="0,12,0,10"/>
                            <ItemsControl x:Name="LiveLegend">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Visible}" Margin="0,4,18,4" Click="OnLegendClick">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="10" Height="3" CornerRadius="1.5" Background="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Name}" FontSize="13"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="ファン / ポンプ（クリックでカーブを編集）" Style="{StaticResource H2}" Margin="0,10,0,12"/>
                    <ItemsControl x:Name="FanCards">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ctl:AdaptiveWrapPanel ItemMinWidth="354" ItemMaxWidth="620"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Card" Style="{StaticResource Card}" Margin="0,0,14,14" Cursor="Hand"
                                        Tag="{Binding ControlId}" MouseLeftButtonUp="OnFanCardClick">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" FontSize="16" TextTrimming="CharacterEllipsis"/>
                                                    <Border CornerRadius="6" Padding="7,1" Margin="8,0,0,0" Background="{Binding RoleBrush}" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RoleText}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DeviceText}" Style="{StaticResource Caption}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,3,0,0"/>
                                                <TextBlock Style="{StaticResource Caption}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                                    <Run Text="Profile:"/>
                                                    <Run Text="{Binding ProfileText, Mode=OneWay}"/>
                                                    <Run Text="  ·  "/>
                                                    <Run Text="{Binding SourceText, Mode=OneWay}"/>
                                                </TextBlock>
                                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                    <TextBlock Text="{Binding RpmText}" FontSize="34" FontWeight="SemiBold"/>
                                                    <TextBlock Text="RPM" FontSize="13" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Bottom" Margin="6,0,0,8"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <!-- 円形ゲージ: 弧 = Duty、中央 = 温度 -->
                                            <ctl:RingGauge Grid.Column="1" Width="78" Height="78" VerticalAlignment="Top"
                                                           Value="{Binding Duty}" CenterText="{Binding TempText}" SubText="{Binding DutyText}"
                                                           Stroke="{Binding StateBrush}"/>
                                        </Grid>
                                        <ctl:Sparkline Height="52" Values="{Binding Values}" Stroke="{Binding RoleBrush}" Margin="0,10,0,0"/>
                                        <DockPanel Margin="0,10,0,0">
                                            <Ellipse Width="7" Height="7" Fill="{Binding StateBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="13" Margin="6,0,0,0"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding DetailText}" Style="{StaticResource Caption}" FontSize="12" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= デバイス ================= -->
            <ScrollViewer x:Name="DevicesPage" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="36,0,22,30" Visibility="Collapsed">
                <ItemsControl x:Name="DeviceCards">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ctl:AdaptiveWrapPanel ItemMinWidth="454" ItemMaxWidth="760"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Card" Style="{StaticResource Card}" Margin="0,0,14,14" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="130" Height="130" CornerRadius="10" Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <ctl:DeviceArt Kind="{Binding Kind}" Source="{Binding Image}" Margin="8"/>
                                    </Border>
                                    <DockPanel Grid.Column="1" Margin="16,2,0,0">
                                        <DockPanel DockPanel.Dock="Bottom">
                                            <Border DockPanel.Dock="Right" CornerRadius="8" Background="{DynamicResource AccentGradient}" MinWidth="44" Padding="12,6"
                                                    Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}" ToolTip="回転中のファンの数">
                                                <TextBlock Text="{Binding BadgeText}" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource IconButton}" Content="&#xE91B;" FontSize="16" Foreground="{DynamicResource SubTextBrush}"
                                                        Tag="{Binding}" Click="OnDeviceImageClick" ToolTip="画像を変更"/>
                                                <Button Style="{StaticResource IconButton}" Content="&#xE9D9;" FontSize="16" Foreground="{DynamicResource SubTextBrush}"
                                                        Click="OnDeviceSensorsClick" ToolTip="センサーを表示" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" FontSize="16" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding KindText}" Style="{StaticResource Caption}" Margin="0,4,0,0" Foreground="{DynamicResource Accent2Brush}"/>
                                            <TextBlock Text="{Binding DetailText}" Style="{StaticResource Caption}" FontSize="12" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ================= ファンカーブ ================= -->
            <Grid x:Name="CurvesPage" Grid.Row="2" Margin="36,0,36,24" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左: プロファイル・ファン一覧と追加 -->
                <DockPanel Margin="0,0,20,0">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="編集するプロファイル" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="EditProfileCombo" DisplayMemberPath="Name" SelectionChanged="OnEditProfileChanged"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="端子を追加" Style="{StaticResource H2}" FontSize="14"/>
                            <TextBlock Text="「テスト」で 8 秒だけ全開にして、どのファンか確認できます（全プロファイルに追加されます）" Style="{StaticResource Caption}" Margin="0,4,0,10"/>
                            <ComboBox x:Name="AddControlCombo" DisplayMemberPath="Display"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource GhostButton}" Content="テスト" Click="OnIdentifyNewClick"/>
                                <Button Grid.Column="2" Style="{StaticResource AccentButton}" Content="追加" Click="OnAddFanClick"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <ListBox x:Name="FanList" Style="{StaticResource CleanList}" ItemContainerStyle="{StaticResource CardListItem}"
                             SelectionChanged="OnFanSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Style="{StaticResource Caption}">
                                        <Run Text="{Binding Role, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding ControlId, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- 右: 選択中ファンの編集 -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="FanEditor" Margin="0,0,10,0">
                        <!-- 基本設定 -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostButton}" Content="テスト（8秒 100%）" Click="OnIdentifyClick" Margin="0,0,8,0"/>
                                        <Button Style="{StaticResource DangerButton}" Content="削除" Click="OnRemoveFanClick"/>
                                    </StackPanel>
                                    <TextBlock Text="基本設定" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="名前（全プロファイル共通）" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="種類" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Role}">
                                            <ComboBoxItem Content="ファン" Tag="Fan"/>
                                            <ComboBoxItem Content="ポンプ（簡易水冷）" Tag="Pump"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" Margin="0,20,0,0">
                                    <StackPanel>
                                        <TextBlock Text="このツールで制御する" FontWeight="SemiBold"/>
                                        <TextBlock Text="オフにすると BIOS の設定で回ります（ポンプは監視だけ続けます）" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </CheckBox>

                                <Border Style="{StaticResource GpuOnly}" Margin="0,14,0,0" CornerRadius="10" Padding="14,10"
                                        Background="{DynamicResource WarnTintBrush}" BorderBrush="{DynamicResource WarnLineBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="GPU のファン（試験的）" FontWeight="SemiBold" Foreground="{DynamicResource WarnBrush}"/>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Text="制御している間は、GPU ドライバーの自動制御（アイドル時に止まる 0 RPM モードなど）が止まります。カーブには GPU の温度を使ってください。GPU 温度が 85°C（Hot Spot は 100°C）を超えると、設定に関係なく 100% にします。"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="制御の方法" Style="{StaticResource Label}" Margin="0,20,0,8"/>
                                <UniformGrid Rows="1">
                                    <RadioButton Style="{StaticResource OptionCard}" Margin="0,0,8,0"
                                                 IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=Curve}">
                                        <StackPanel>
                                            <TextBlock Text="カーブ" FontWeight="SemiBold"/>
                                            <TextBlock Text="温度ごとの回転数を自分で決める" Style="{StaticResource Caption}" FontSize="12"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource OptionCard}" Margin="0,0,8,0"
                                                 IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=Target}">
                                        <StackPanel>
                                            <TextBlock Text="目標温度（おまかせ）" FontWeight="SemiBold"/>
                                            <TextBlock Text="温度を決めるだけで自動調整" Style="{StaticResource Caption}" FontSize="12"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource OptionCard}" Margin="0,0,8,0"
                                                 IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=Fixed}">
                                        <StackPanel>
                                            <TextBlock Text="固定" FontWeight="SemiBold"/>
                                            <TextBlock Text="いつも同じ回転（ポンプ向け）" Style="{StaticResource Caption}" FontSize="12"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource OptionCard}" Margin="0"
                                                 IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=Follow}">
                                        <StackPanel>
                                            <TextBlock Text="連動（グループ）" FontWeight="SemiBold"/>
                                            <TextBlock Text="他のファンと回転を揃える" Style="{StaticResource Caption}" FontSize="12"/>
                                        </StackPanel>
                                    </RadioButton>
                                </UniformGrid>

                                <!-- 目標温度モード -->
                                <Border Style="{StaticResource TargetOnly}" Margin="0,16,0,0" CornerRadius="10" Padding="14"
                                        Background="{DynamicResource AccentTintBrush}" BorderBrush="{DynamicResource AccentLineBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="目標温度モード" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,12"
                                                   Text="選んだ温度が目標を超えないよう、できるだけ低い回転で自動調整します。カーブを考える必要はありません。目標より高い状態が続くほど、少しずつ回転を上げます。"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="136"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="42"/>
                                                <RowDefinition Height="34"/>
                                                <RowDefinition Height="34"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="見る温度" Style="{StaticResource Label}"/>
                                            <ComboBox x:Name="TargetSensorCombo" Grid.Column="1" Grid.ColumnSpan="2" DisplayMemberPath="Display" SelectedValuePath="Id"
                                                      SelectedValue="{Binding TargetSensorId}"/>
                                            <TextBlock Grid.Row="1" Text="目標温度" Style="{StaticResource Label}"/>
                                            <Slider Grid.Row="1" Grid.Column="1" Minimum="40" Maximum="95" Value="{Binding TargetTemp}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding TargetTemp, StringFormat={}{0:F0}°C}"/>
                                            <TextBlock Grid.Row="2" Text="反応の強さ" Style="{StaticResource Label}" ToolTip="大きいほど温度の変化にきびきび反応します（小さいほど静かでゆったり）"/>
                                            <Slider Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="10" Value="{Binding TargetAggressiveness}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding TargetAggressiveness, StringFormat={}{0:F0}}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 連動モード（ファングループ） -->
                                <Border Style="{StaticResource FollowOnly}" Margin="0,16,0,0" CornerRadius="10" Padding="14"
                                        Background="{DynamicResource Accent2TintBrush}" BorderBrush="{DynamicResource Accent2LineBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="連動モード（ファングループ）" FontWeight="SemiBold" Foreground="{DynamicResource Accent2Brush}"/>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,12"
                                                   Text="選んだファン（リーダー）と同じ回転にします。前面の吸気ファン同士など、同じ役割のファンを揃えると「ウォンウォン」といううなりを防げます。"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="136"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="42"/>
                                                <RowDefinition Height="34"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="合わせる相手" Style="{StaticResource Label}"/>
                                            <ComboBox x:Name="FollowCombo" Grid.Column="1" Grid.ColumnSpan="2" DisplayMemberPath="Name" SelectedValuePath="ControlId"
                                                      SelectedValue="{Binding FollowControlId}"/>
                                            <TextBlock Grid.Row="1" Text="上乗せ" Style="{StaticResource Label}" ToolTip="リーダーより少し速く／遅く回したいときに使います"/>
                                            <Slider Grid.Row="1" Grid.Column="1" Minimum="-30" Maximum="30" Value="{Binding FollowOffset}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding FollowOffset, StringFormat={}{0:+0;-0;0}%}"/>
                                        </Grid>
                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding FollowMatchRpm}" Margin="0,10,0,0">
                                            <StackPanel>
                                                <TextBlock Text="回転数（rpm）で揃える" FontWeight="SemiBold"/>
                                                <TextBlock Text="両方のファンをキャリブレーション済みなら、% ではなく実際の回転数を合わせます（型番の違うファン同士でも揃う）" Style="{StaticResource Caption}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,18,0,0" Visibility="{Binding UseFixedDuty, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="固定回転数" Style="{StaticResource Label}"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding FixedDuty}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{Binding FixedDuty, StringFormat={}{0:F0}%}"/>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="34"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="最低回転数" Style="{StaticResource Label}"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding MinDuty}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{Binding MinDuty, StringFormat={}{0:F0}%}"/>
                                    <TextBlock x:Name="MinDutyWarning" Grid.Row="1" Grid.Column="1" Style="{StaticResource Caption}"
                                               Foreground="{DynamicResource WarnBrush}" Margin="0,0,0,6" Visibility="Collapsed"/>

                                    <TextBlock Grid.Row="2" Text="上昇の速さ / 秒" Style="{StaticResource Label}"/>
                                    <Slider Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="30" Value="{Binding MaxStepUpPerTick}" IsSnapToTickEnabled="True" TickFrequency="0.5"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding MaxStepUpPerTick, StringFormat={}{0:F1}%}"/>

                                    <TextBlock Grid.Row="3" Text="下降の速さ / 秒" Style="{StaticResource Label}"/>
                                    <Slider Grid.Row="3" Grid.Column="1" Minimum="0.5" Maximum="20" Value="{Binding MaxStepDownPerTick}" IsSnapToTickEnabled="True" TickFrequency="0.5"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding MaxStepDownPerTick, StringFormat={}{0:F1}%}"/>
                                </Grid>

                                <!-- ポンプ専用 -->
                                <Border Style="{StaticResource PumpOnly}" Margin="0,16,0,0" CornerRadius="10" Padding="14"
                                        Background="{DynamicResource Accent2TintBrush}" BorderBrush="{DynamicResource Accent2LineBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="ポンプ保護" FontWeight="SemiBold" Foreground="{DynamicResource Accent2Brush}"/>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,10"
                                                   Text="どの設定でも 40% 未満にはなりません。回転数が警告値を 3 秒続けて下回ると、BIOS 制御中でも 100% にして通知します。"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="136"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="警告する回転数" Style="{StaticResource Label}"/>
                                            <Slider Grid.Column="1" Minimum="300" Maximum="2500" Value="{Binding PumpAlertRpm}" IsSnapToTickEnabled="True" TickFrequency="50"/>
                                            <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{Binding PumpAlertRpm, StringFormat={}{0:F0} rpm}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 自動キャリブレーション（ファンのみ） -->
                        <Border Style="{StaticResource FanOnly}" Margin="0,0,0,14">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button x:Name="ApplyCalibrationButton" Style="{StaticResource GhostButton}" Content="最低回転数に反映"
                                                    Click="OnApplyCalibrationClick" Margin="0,0,8,0" Visibility="Collapsed"/>
                                            <Button x:Name="CalibrateButton" Style="{StaticResource AccentButton}" Content="自動キャリブレーション" Click="OnCalibrateClick"/>
                                            <Button x:Name="CancelCalibrationButton" Style="{StaticResource DangerButton}" Content="中止" Click="OnCancelCalibrationClick" Visibility="Collapsed"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="自動キャリブレーション" Style="{StaticResource H2}"/>
                                            <TextBlock Text="ファンを 0〜100% で動かして、止まる回転数・回り始める回転数・最大回転数を測ります（約 1〜2 分）" Style="{StaticResource Caption}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <ProgressBar x:Name="CalibrationProgressBar" Style="{StaticResource DutyBar}" Margin="0,14,0,0" Visibility="Collapsed"/>
                                    <TextBlock x:Name="CalibrationText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SubTextBrush}"/>
                                </StackPanel>
                            </Border>
                        </Border>

                        <!-- 共振回避（ファンのみ） -->
                        <Border Style="{StaticResource FanOnly}" Margin="0,0,0,14">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="＋ 帯を追加" Click="OnAddBandClick" VerticalAlignment="Top"/>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="共振回避（うるさい回転数を避ける）" Style="{StaticResource H2}"/>
                                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                       Text="ケースやラジエーターが「ブーン」と共鳴する回転数の帯を登録すると、その帯の中には留まらず素早く通り過ぎます（全プロファイル共通）"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <Border Background="{DynamicResource OverlayBrush}" CornerRadius="10" Padding="14" Margin="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock Text="回転数を試す" FontWeight="SemiBold"/>
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,10" TextWrapping="Wrap"
                                                       Text="スライダーを動かすと、このファンだけ実際にその回転数になります（操作をやめて 20 秒たつと元に戻ります）。うるさい所が見つかったら「ここを避ける」を押してください。"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="ListenSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                                        ValueChanged="OnListenChanged"/>
                                                <TextBlock x:Name="ListenDutyText" Grid.Column="1" Style="{StaticResource Value}" Text="--"/>
                                                <TextBlock x:Name="ListenRpmText" Grid.Column="2" Style="{StaticResource Value}" Foreground="{DynamicResource Accent2Brush}" Text=""/>
                                                <Button Grid.Column="3" Style="{StaticResource SmallGhost}" Content="ここを避ける" Click="OnAvoidHereClick" Margin="8,0,0,0"/>
                                                <Button x:Name="StopListenButton" Grid.Column="4" Style="{StaticResource SmallGhost}" Content="元に戻す" Click="OnStopListenClick"
                                                        Margin="6,0,0,0" Visibility="Collapsed"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <ItemsControl x:Name="BandList" ItemsSource="{Binding AvoidBands}" Margin="0,12,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="12,6" Margin="0,0,0,6">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="削除" Tag="{Binding}"
                                                                Click="OnRemoveBandClick" Padding="10,4" FontSize="13"/>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="10" Height="10" CornerRadius="2" Background="#F472B6" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="避ける範囲" Style="{StaticResource Label}" Margin="0,0,10,0"/>
                                                            <TextBox Style="{StaticResource SmallInput}" Width="52" Text="{Binding From, StringFormat={}{0:F0}}" LostFocus="OnBandEdited"/>
                                                            <TextBlock Text="% 〜" Style="{StaticResource Label}" Margin="6,0"/>
                                                            <TextBox Style="{StaticResource SmallInput}" Width="52" Text="{Binding To, StringFormat={}{0:F0}}" LostFocus="OnBandEdited"/>
                                                            <TextBlock Text="%" Style="{StaticResource Label}" Margin="6,0,0,0"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="BandEmptyText" Style="{StaticResource Caption}" Text="まだ登録されていません。気になる音がなければ、このままで大丈夫です。"/>
                                </StackPanel>
                            </Border>
                        </Border>

                        <!-- カーブ -->
                        <Border Style="{StaticResource CurveOnly}">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Style="{StaticResource AccentButton}" Content="自動で作る…" Click="OnGoAutoTuneClick" Margin="0,0,8,0"
                                                    ToolTip="負荷をかけて測り、目標温度を守れる最も静かなカーブを自動で作ります（テスト・調整画面）"/>
                                            <Button x:Name="CopyCurveButton" Style="{StaticResource GhostButton}" Content="コピー ▾" Click="OnCopyCurveClick" Margin="0,0,8,0"/>
                                            <Button Style="{StaticResource GhostButton}" Content="＋ カーブを追加" Click="OnAddCurveClick" Margin="0,0,8,0"/>
                                            <Button Style="{StaticResource DangerButton}" Content="このカーブを削除" Click="OnRemoveCurveClick"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="ファンカーブ" Style="{StaticResource H2}"/>
                                            <TextBlock Text="複数のカーブがあるときは、要求の高いほうを採用します" Style="{StaticResource Caption}"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <ListBox x:Name="CurveTabs" Style="{StaticResource CleanList}" ItemContainerStyle="{StaticResource TabItemStyle}"
                                             Margin="0,16,0,0" SelectionChanged="OnCurveSelectionChanged"
                                             ItemsSource="{Binding Curves}" DisplayMemberPath="Name">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                    </ListBox>

                                    <StackPanel x:Name="CurveEditorPanel" Margin="0,16,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="カーブ名" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="連動する温度センサー" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                                <ComboBox x:Name="SensorCombo" DisplayMemberPath="Display" SelectedValuePath="Id"
                                                          SelectedValue="{Binding SensorId}"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                            <TextBlock Text="プリセット" Style="{StaticResource Label}" Margin="0,0,12,0"/>
                                            <Button Style="{StaticResource SmallGhost}" Content="静音" Tag="静音" Click="OnPresetClick" Margin="0,0,6,0"/>
                                            <Button Style="{StaticResource SmallGhost}" Content="バランス" Tag="バランス" Click="OnPresetClick" Margin="0,0,6,0"/>
                                            <Button Style="{StaticResource SmallGhost}" Content="冷却重視" Tag="冷却重視" Click="OnPresetClick" Margin="0,0,6,0"/>
                                            <Button Style="{StaticResource SmallGhost}" Content="全開" Tag="全開" Click="OnPresetClick"/>
                                        </StackPanel>

                                        <ctl:CurveEditor x:Name="CurveGraph" Height="340" Margin="0,14,0,0" PointsChanged="OnCurvePointsChanged"/>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                                   Text="点をドラッグで移動（Shift で 5 刻み） ／ 空白をダブルクリックで追加 ／ 点を右クリックで削除 ／ Ctrl+Z で元に戻す"/>

                                        <!-- 点の数値入力 -->
                                        <ItemsControl x:Name="PointsList" Margin="0,12,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="8,6" Margin="0,0,8,8">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBox Style="{StaticResource SmallInput}" Width="52" Text="{Binding Temp, StringFormat={}{0:F0}}" LostFocus="OnPointEdited"/>
                                                            <TextBlock Text="°C →" Style="{StaticResource Label}" Margin="6,0"/>
                                                            <TextBox Style="{StaticResource SmallInput}" Width="52" Text="{Binding Duty, StringFormat={}{0:F0}}" LostFocus="OnPointEdited"/>
                                                            <TextBlock Text="%" Style="{StaticResource Label}" Margin="6,0,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="34"/>
                                                <RowDefinition Height="34"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="ヒステリシス" Style="{StaticResource Label}"
                                                       ToolTip="温度が下がるとき、この温度差だけ遅れて回転を下げます（うなり防止）"/>
                                            <Slider Grid.Column="1" Minimum="0" Maximum="10" Value="{Binding HysteresisCelsius}" IsSnapToTickEnabled="True" TickFrequency="0.5"/>
                                            <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{Binding HysteresisCelsius, StringFormat={}{0:F1}°C}"/>

                                            <TextBlock Grid.Row="1" Text="反応の速さ" Style="{StaticResource Label}"
                                                       ToolTip="小さいほど温度の急な変化を無視してゆったり動きます（EMA 係数）"/>
                                            <Slider Grid.Row="1" Grid.Column="1" Minimum="0.05" Maximum="1" Value="{Binding EmaAlpha}" IsSnapToTickEnabled="True" TickFrequency="0.05"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding EmaAlpha, StringFormat={}{0:F2}}"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 初期化中・未選択の表示 -->
                <Border x:Name="CurvesPlaceholder" Grid.ColumnSpan="2" Background="{DynamicResource BgBrush}">
                    <TextBlock x:Name="CurvesPlaceholderText" Text="ハードウェアを初期化しています…" Style="{StaticResource Caption}" FontSize="15"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- ================= 履歴 ================= -->
            <Grid x:Name="HistoryPage" Grid.Row="2" Margin="36,0,36,30" Visibility="Collapsed">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <ItemsControl x:Name="HistoryLegend" DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Visible}" Margin="0,4,18,4" Click="OnLegendClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="10" Height="3" CornerRadius="1.5" Background="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Name}" FontSize="13"/>
                                            <TextBlock Text="{Binding Unit}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock DockPanel.Dock="Top" x:Name="HistoryInfo" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                        <ctl:HistoryChart x:Name="HistoryGraph" MinHeight="300"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ================= 診断（自動診断・ファンのホコリと劣化・AI はオプション） ================= -->
            <ScrollViewer x:Name="ToolsPage" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="36,0,36,30" Visibility="Collapsed">
                <StackPanel>
                    <!-- オプション機能: AI 冷却アドバイザー（既定はオフ。オンにすると、すぐ下にカードが出る） -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" CornerRadius="6" Padding="8,3" Margin="0,0,14,0" VerticalAlignment="Top"
                                    BorderThickness="1" BorderBrush="{DynamicResource Accent2Brush}">
                                <TextBlock Text="オプション" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent2Brush}"/>
                            </Border>
                            <CheckBox x:Name="AdvisorEnabledSwitch" Style="{StaticResource Switch}" Click="OnAdvisorEnabledClick">
                                <StackPanel>
                                    <TextBlock Text="AI 冷却アドバイザーを使う（実験的な機能）" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                               Text="オンにすると、すぐ下に AI のアドバイスの欄が出ます。記録の統計と設定を、この PC で動く Ollama に渡して分析させます（データは PC の外に出ません）。Ollama と AI のモデル（数 GB）を別に入れる必要があります。回答を作るあいだは CPU・GPU に負荷がかかるので、温度が上がることがあります。設定を書き換えることはありません"/>
                                </StackPanel>
                            </CheckBox>
                        </DockPanel>
                    </Border>

                    <!-- AI 冷却アドバイザー: 上の「オプション」のスイッチでオンにしたときだけ出す -->
                    <Border x:Name="AdvisorCard" Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="AI 冷却アドバイザー（Ollama）" Style="{StaticResource H2}"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,14"
                                       Text="記録の統計（最小・平均・最大など）と設定・診断・冷却テストの結果を、この PC で動いている Ollama に渡して分析させます。データは PC の外に送信されません。"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ollama の URL" Style="{StaticResource Label}"/>
                                <TextBox x:Name="OllamaUrlBox" Grid.Column="1" LostFocus="OnAdvisorSettingChanged"/>
                                <TextBlock Grid.Column="3" Text="モデル" Style="{StaticResource Label}" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                <ComboBox x:Name="ModelCombo" Grid.Column="4" SelectionChanged="OnModelChanged"/>
                                <Button Grid.Column="5" Style="{StaticResource SmallGhost}" Content="一覧を更新" Click="OnRefreshModelsClick" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBox x:Name="QuestionBox" Margin="0,12,0,0" ToolTip="AI に聞きたいこと（任意）"
                                     Text="" Tag="質問（任意）"/>
                            <TextBlock Style="{StaticResource Caption}" FontSize="12" Margin="2,4,0,0" Text="例: ゲーム中のファンの音を静かにしたい ／ ラジエーターファンのカーブを見直したい（空欄でも分析できます）"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="AnalyzeButton" Style="{StaticResource AccentButton}" Content="分析する" Click="OnAnalyzeClick" Margin="0,0,8,0"/>
                                <Button x:Name="StopAnalyzeButton" Style="{StaticResource DangerButton}" Content="停止" Click="OnStopAnalyzeClick" Margin="0,0,8,0" Visibility="Collapsed"/>
                                <Button Style="{StaticResource GhostButton}" Content="AI に渡す内容を見る" Click="OnShowPromptClick"/>
                                <TextBlock x:Name="AdvisorStatus" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                            <TextBox x:Name="AdvisorOutput" Margin="0,12,0,0" MinHeight="320" IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" AcceptsReturn="True" FontSize="14" VerticalContentAlignment="Top"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <ComboBox x:Name="DiagWindowCombo" Width="140" Margin="0,0,8,0" SelectedValuePath="Tag">
                                        <ComboBoxItem Content="直近 30 分" Tag="30"/>
                                        <ComboBoxItem Content="直近 2 時間" Tag="120" IsSelected="True"/>
                                        <ComboBoxItem Content="記録すべて" Tag="1440"/>
                                    </ComboBox>
                                    <Button Style="{StaticResource AccentButton}" Content="診断する" Click="OnRunDiagnosticsClick"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="自動診断" Style="{StaticResource H2}"/>
                                    <TextBlock Text="記録から、回転のふらつき・冷やしすぎ・冷え不足・停止域・うなりなどを見つけて、調整案を出します。ゲームなどで負荷をかけた後に実行すると効果的です" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl x:Name="FindingsList" Margin="0,14,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource InputBrush}" CornerRadius="10" Margin="0,0,0,8">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Width="4" CornerRadius="10,0,0,10" Background="{Binding LevelBrush}"/>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{Binding ActionLabel}" Tag="{Binding}"
                                                        Click="OnApplyFindingClick" Margin="12" VerticalAlignment="Center" FontSize="13" Padding="12,6"
                                                        Visibility="{Binding CanApply, Converter={StaticResource BoolToVis}}"/>
                                                <StackPanel Margin="14,12">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border CornerRadius="6" Padding="7,1" Background="{Binding LevelBrush}" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding LevelText}" FontSize="11" FontWeight="Bold" Foreground="#10111A"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="8,0,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                                                    <TextBlock Text="{Binding ResultText}" Foreground="{DynamicResource OkBrush}" FontSize="13" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ファンの劣化・ホコリ -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Style="{StaticResource GhostButton}" Content="掃除した（ここを新しい基準にする）" Click="OnCleanedClick" Margin="0,0,8,0"
                                            ToolTip="フィルターやファンを掃除したら押してください。これ以降の記録を新しい基準にして比べます"/>
                                    <Button Style="{StaticResource AccentButton}" Content="今すぐ調べる" Click="OnAnalyzeHealthClick"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="ファンの劣化・ホコリのチェック" Style="{StaticResource H2}"/>
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                               Text="1 分ごとの記録を保存して、「同じ回転の指示なのに回転数が下がっていないか（軸受けの劣化・ホコリ）」「同じ消費電力なのに温度が上がっていないか（フィルター・ラジエーターの目詰まり）」を、以前と比べます。"/>
                                    <TextBlock x:Name="HealthInfo" Style="{StaticResource Caption}" Foreground="{DynamicResource Accent2Brush}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl x:Name="HealthList" Margin="0,14,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource InputBrush}" CornerRadius="10" Margin="0,0,0,8">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Width="4" CornerRadius="10,0,0,10" Background="{Binding LevelBrush}"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ChangeText}" FontSize="18" FontWeight="SemiBold" Foreground="{Binding LevelBrush}"
                                                           VerticalAlignment="Center" Margin="12,0,16,0"/>
                                                <StackPanel Margin="14,12">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border CornerRadius="6" Padding="7,1" Background="{Binding LevelBrush}" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding LevelText}" FontSize="11" FontWeight="Bold" Foreground="#10111A"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                                        <TextBlock Text="{Binding Metric}" Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= 冷却テスト ================= -->
            <ScrollViewer x:Name="TestPage" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="36,0,36,30" Visibility="Collapsed">
                <StackPanel>
                    <!-- おまかせ調整（カーブの自動作成） -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button x:Name="StartTuneButton" Style="{StaticResource AccentButton}" Content="自動調整を開始" Click="OnStartTuneClick"/>
                                    <Button x:Name="CancelTuneButton" Style="{StaticResource DangerButton}" Content="中止" Click="OnCancelTuneClick" Visibility="Collapsed"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="おまかせ調整（カーブを自動で作る）" Style="{StaticResource H2}"/>
                                        <Border Style="{StaticResource Badge}">
                                            <TextBlock Text="おすすめ" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                               Text="実際に負荷をかけたまま、ファンの回転を 100% から少しずつ下げて、温度が落ち着くところを測ります。その結果から「目標温度を守れる、いちばん静かなカーブ」を作ります（約 8〜15 分。途中で中止しても、いつもの制御に戻ります）。"/>
                                </StackPanel>
                            </DockPanel>

                            <Grid x:Name="TuneSettings" Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="冷やす対象" Style="{StaticResource Label}"/>
                                <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton x:Name="TuneCpu" Style="{StaticResource Segment}" GroupName="TuneTarget" IsChecked="True" Checked="OnTuneTargetChanged"
                                                 Content="CPU（内蔵の負荷で自動）"/>
                                    <RadioButton x:Name="TuneGpu" Style="{StaticResource Segment}" GroupName="TuneTarget" Checked="OnTuneTargetChanged"
                                                 Content="GPU（ゲームやベンチマークで負荷）"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="目標温度" Style="{StaticResource Label}" ToolTip="全力で負荷をかけたときに、この温度を超えないようにします"/>
                                <Slider x:Name="TuneTargetSlider" Grid.Row="1" Grid.Column="1" Minimum="55" Maximum="95" Value="80"
                                        IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnTuneTargetValueChanged"/>
                                <TextBlock x:Name="TuneTargetText" Grid.Row="1" Grid.Column="2" Style="{StaticResource Value}" Text="80°C"/>
                                <TextBlock Grid.Row="2" Text="調整するファン" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,6,0,0"/>
                                <ItemsControl x:Name="TuneFans" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Selected}" Margin="0,4,20,4" ToolTip="{Binding Hint}">
                                                <TextBlock>
                                                    <Run Text="{Binding Name, Mode=OneWay}"/>
                                                    <Run Text="{Binding Hint, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                                </TextBlock>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <ProgressBar x:Name="TuneProgress" Style="{StaticResource DutyBar}" Margin="0,14,0,0" Visibility="Collapsed"/>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock x:Name="TuneLive" DockPanel.Dock="Right" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TuneStatus" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Text="選んだファンを同じ回転数にそろえて測ります。ポンプは対象外です（いつもどおり動きます）。"/>
                            </DockPanel>

                            <!-- 結果 -->
                            <Grid x:Name="TuneResultPanel" Margin="0,16,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="測定結果" Style="{StaticResource H2}" FontSize="15"/>
                                    <TextBlock x:Name="TuneIdleText" Style="{StaticResource Caption}" Margin="0,4,0,8"/>
                                    <ItemsControl x:Name="TuneSteps">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding DutyText}" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding TempText}" Foreground="{Binding Brush}" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding RpmText}" Style="{StaticResource Caption}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="TuneNeedText" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TuneAbortText" Style="{StaticResource Caption}" Foreground="{DynamicResource WarnBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="作られるカーブ（上の目標温度を動かすと、測り直さずに作り直せます）" Style="{StaticResource Caption}"/>
                                    <ctl:CurveEditor x:Name="TuneCurve" Height="230" Margin="0,8,0,0" ReadOnly="True"/>
                                    <WrapPanel Margin="0,12,0,0">
                                        <ComboBox x:Name="TuneProfileCombo" Width="170" DisplayMemberPath="Name" Margin="0,0,8,8"/>
                                        <Button Style="{StaticResource GhostButton}" Content="このプロファイルに適用" Click="OnApplyTuneClick" Margin="0,0,8,8"/>
                                        <Button Style="{StaticResource AccentButton}" Click="OnApplyTuneAllClick" Margin="0,0,0,8"
                                                ToolTip="名前に「静音」が付くプロファイルは目標 +5°C、「パフォーマンス」は目標 −5°C、それ以外は目標どおりで作ります">
                                            <TextBlock Text="全プロファイルにまとめて適用"/>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <RadioButton x:Name="Test5" Style="{StaticResource Segment}" Content="5分" GroupName="TestLen" Tag="5"/>
                                    <RadioButton x:Name="Test10" Style="{StaticResource Segment}" Content="10分" GroupName="TestLen" Tag="10" IsChecked="True"/>
                                    <RadioButton x:Name="Test15" Style="{StaticResource Segment}" Content="15分" GroupName="TestLen" Tag="15" Margin="0,0,14,0"/>
                                    <Button x:Name="StartTestButton" Style="{StaticResource AccentButton}" Content="テスト開始" Click="OnStartTestClick"/>
                                    <Button x:Name="CancelTestButton" Style="{StaticResource DangerButton}" Content="中止" Click="OnCancelTestClick" Visibility="Collapsed"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="冷却テスト" Style="{StaticResource H2}"/>
                                    <TextBlock Style="{StaticResource Caption}"
                                               Text="待機 30 秒 → CPU 全コアに負荷 → 負荷を止めて冷却、の順に自動で測ります。今のファン設定でどこまで冷えるかが分かります。GPU は含まれないので、GPU も試すときはテスト中にゲームやベンチマークを動かしてください。"/>
                                </StackPanel>
                            </DockPanel>
                            <ProgressBar x:Name="TestProgress" Style="{StaticResource DutyBar}" Margin="0,16,0,0"/>
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock x:Name="TestLive" DockPanel.Dock="Right" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TestStatus" Style="{StaticResource Caption}" Text="準備ができたら「テスト開始」を押してください。重いアプリは閉じておくと正確に測れます。"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="テスト・調整中の推移" Style="{StaticResource H2}"/>
                            <ctl:HistoryChart x:Name="TestChart" Height="280" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="TestResultCard" Style="{StaticResource Card}" Visibility="Collapsed">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Style="{StaticResource GhostButton}" Content="レポートを保存" Click="OnSaveReportClick" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource AccentButton}" Content="AI に分析させる" Click="OnAnalyzeTestClick"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="結果" Style="{StaticResource H2}"/>
                                    <TextBlock x:Name="TestVerdict" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock x:Name="TestReportText" Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="22"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= レポート ================= -->
            <ScrollViewer x:Name="ReportPage" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="36,0,36,30" Visibility="Collapsed">
                <StackPanel>
                    <!-- 電力と電気代 -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <RadioButton x:Name="EnergyYen" Style="{StaticResource Segment}" Content="電気代（円）" GroupName="EnergyUnit" IsChecked="True" Checked="OnEnergyUnitChanged"/>
                                    <RadioButton Style="{StaticResource Segment}" Content="電力量（kWh）" GroupName="EnergyUnit" Checked="OnEnergyUnitChanged"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="電力と電気代（目安）" Style="{StaticResource H2}"/>
                                    <TextBlock x:Name="EnergyNote" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                            <UniformGrid Columns="4" Margin="0,16,0,0">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="いまの消費電力" Style="{StaticResource Caption}"/>
                                    <TextBlock x:Name="EnergyNow" Text="--" FontSize="26" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="EnergyNowSub" Style="{StaticResource Caption}" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="今日" Style="{StaticResource Caption}"/>
                                    <TextBlock x:Name="EnergyToday" Text="--" FontSize="26" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="EnergyTodaySub" Style="{StaticResource Caption}" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="今月" Style="{StaticResource Caption}"/>
                                    <TextBlock x:Name="EnergyMonth" Text="--" FontSize="26" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="EnergyMonthSub" Style="{StaticResource Caption}" FontSize="12"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="今月の見込み" Style="{StaticResource Caption}"/>
                                    <TextBlock x:Name="EnergyForecast" Text="--" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Accent2Brush}"/>
                                    <TextBlock x:Name="EnergyForecastSub" Style="{StaticResource Caption}" FontSize="12"/>
                                </StackPanel>
                            </UniformGrid>
                            <ctl:BarChart x:Name="EnergyChart" Height="200" Margin="0,16,0,0"/>
                            <TextBlock Style="{StaticResource Caption}" FontSize="12" Margin="0,6,0,0" Text="直近 30 日 ／ 棒にマウスを乗せると、その日の値を表示します。単価などは 設定 →「通知・連携」で変更できます"/>
                        </StackPanel>
                    </Border>

                    <!-- 異常の記録 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="フォルダを開く" Click="OnOpenRecordsClick" VerticalAlignment="Top"/>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="異常の記録（フライトレコーダー）" Style="{StaticResource H2}"/>
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                               Text="緊急全開・ポンプ異常・ファンの停止などが起きたとき、前後 10 分のすべての温度と回転数を自動で保存します。原因を調べるときや、AI に相談するときに使えます。"/>
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl x:Name="RecordsList" Margin="0,14,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource InputBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource SmallGhost}" Content="概要" Tag="{Binding}" Click="OnShowRecordClick" Margin="0,0,6,0"/>
                                                    <Button Style="{StaticResource SmallGhost}" Content="CSV を開く" Tag="{Binding}" Click="OnOpenRecordClick"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding TimeText}" Style="{StaticResource Caption}" FontSize="12"/>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,12,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="RecordsEmpty" Style="{StaticResource Caption}" Text="まだ記録はありません（危険な状態になったことがない、ということです）。"/>
                            <TextBox x:Name="RecordSummary" Margin="0,8,0,0" MinHeight="180" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontSize="13" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= センサー ================= -->
            <ScrollViewer x:Name="SensorsPage" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="36,0,36,30" Visibility="Collapsed">
                <StackPanel>
                    <!-- 仮想センサー -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="仮想センサー" Style="{StaticResource H2}"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,12"
                                       Text="複数のセンサーの最大値・平均値や、2 つのセンサーの差（例: 水温 − 室温）を作って、カーブの連動先に使えます。"/>
                            <ItemsControl x:Name="VirtualList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource InputBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="削除" Tag="{Binding Config}"
                                                        Click="OnRemoveVirtualClick" Padding="12,5" FontSize="13"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}" FontWeight="SemiBold" FontSize="16"
                                                           VerticalAlignment="Center" Margin="0,0,18,0" Foreground="{DynamicResource Accent2Brush}"/>
                                                <StackPanel>
                                                    <TextBlock>
                                                        <Run Text="{Binding Config.Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                        <Run Text="  "/>
                                                        <Run Text="{Binding Config.KindText, Mode=OneWay}" Foreground="{DynamicResource Accent2Brush}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding SourcesText}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Background="{DynamicResource OverlayBrush}" CornerRadius="10" Padding="14" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="新しい仮想センサー" FontWeight="SemiBold"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="NewVirtualName" Text="仮想センサー"/>
                                        <ComboBox x:Name="NewVirtualKind" Grid.Column="2" SelectedValuePath="Tag" SelectionChanged="OnVirtualKindChanged">
                                            <ComboBoxItem Content="最大値（いちばん高い温度）" Tag="Max" IsSelected="True"/>
                                            <ComboBoxItem Content="平均値" Tag="Average"/>
                                            <ComboBoxItem Content="最小値" Tag="Min"/>
                                            <ComboBoxItem Content="差分（A − B）" Tag="Delta"/>
                                        </ComboBox>
                                    </Grid>
                                    <ItemsControl x:Name="VirtualSourcePicker" Margin="0,12,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Selected}" Content="{Binding Display}"
                                                          Margin="0,4,20,4" FontSize="13"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid x:Name="DeltaPicker" Margin="0,12,0,0" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="A" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="DeltaA" Grid.Column="1" DisplayMemberPath="Display"/>
                                        <TextBlock Grid.Column="2" Text="− B" Style="{StaticResource Label}" HorizontalAlignment="Center"/>
                                        <ComboBox x:Name="DeltaB" Grid.Column="3" DisplayMemberPath="Display"/>
                                    </Grid>
                                    <Button Style="{StaticResource AccentButton}" Content="作成" Click="OnAddVirtualClick" HorizontalAlignment="Right" Margin="0,12,0,0" MinWidth="100"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <ItemsControl x:Name="SensorGroups">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource H2}"/>
                                            <TextBlock Text="{Binding HardwareType}" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="70"/>
                                                            <ColumnDefinition Width="260"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding TypeText}" Style="{StaticResource Caption}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,24,0"/>
                                                        <TextBox Grid.Column="3" Text="{Binding Id, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                                                 Background="Transparent" Foreground="{DynamicResource MutedBrush}" Padding="0" FontSize="13"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= ライティング（OpenRGB 連携） ================= -->
            <!-- DataContext は設定（AppConfig）。MainWindow.Lighting.cs の InitLighting で設定する -->
            <ScrollViewer x:Name="LightingPage" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="36,0,36,30" Visibility="Collapsed">
                <StackPanel>

                    <!-- ===== 接続 ===== -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel>
                                <Border x:Name="RgbSwatch" DockPanel.Dock="Right" Width="30" Height="30" CornerRadius="15" Background="{DynamicResource MutedBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Top"
                                        ToolTip="いま LED に送っている色（LED ごとに違うときは先頭の色）"/>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="接続" Style="{StaticResource H2}"/>
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                               Text="無料の OpenRGB を通して、マザーボード・メモリ・ファン・LED テープなどの色を変えます。OpenRGB を起動して「SDK Server」を開始しておいてください（つながらないときは、OpenRGB の起動オプションに --server を付けます）。"/>
                                </StackPanel>
                            </DockPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Rgb.Enabled}" Margin="0,16,0,0"
                                      ToolTip="オンにすると OpenRGB に接続して、下で選んだ光り方で LED の色を変えます。オフにすると、このアプリは LED に何も送りません">
                                <StackPanel>
                                    <TextBlock Text="OpenRGB と連携する" FontWeight="SemiBold"/>
                                    <TextBlock Text="OpenRGB が対応している LED が対象です。ASRock Polychrome などメーカーの RGB ソフトとは同時に使わないでください（取り合いになってチカチカします）" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Rgb.LightsOff}" Margin="0,12,0,0"
                                      IsEnabled="{Binding Rgb.Enabled}"
                                      ToolTip="LED をすべて消します。連携は続けるので、機器が自分の光り方（レインボーなど）に戻りません。タスクトレイの「LED の光り方」からも切り替えられます">
                                <StackPanel>
                                    <TextBlock Text="消灯する（連携は続ける）" FontWeight="SemiBold"/>
                                    <TextBlock Text="寝るときや画面を暗くしたいときに。設定はそのまま残るので、オフに戻すと同じ光り方で点きます" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </CheckBox>
                            <DockPanel Style="{StaticResource LightRow}" Margin="0,12,0,0">
                                <TextBlock Text="接続先" Style="{StaticResource RowLabel}"
                                           ToolTip="OpenRGB の SDK サーバーの場所。同じ PC なら 127.0.0.1 : 6742 のままで大丈夫です"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Width="150" Text="{Binding Rgb.Host}" ToolTip="OpenRGB が動いている PC のアドレス（同じ PC なら 127.0.0.1）"/>
                                    <TextBlock Text=":" Style="{StaticResource Label}" Margin="6,0"/>
                                    <TextBox Width="70" Text="{Binding Rgb.Port}" ToolTip="OpenRGB の SDK サーバーのポート番号（ふつうは 6742）"/>
                                    <Button Style="{StaticResource SmallGhost}" Content="接続テスト" Click="OnTestRgbClick" Margin="10,0,0,0"
                                            ToolTip="OpenRGB につながるか確かめて、見つかったデバイスを下の一覧に表示します（LED の色は変えません）"/>
                                    <Button Style="{StaticResource SmallGhost}" Content="今すぐ再接続" Click="OnRgbReconnectClick" Margin="6,0,0,0"
                                            ToolTip="OpenRGB を起動し直したときや、デバイスを付け外ししたときに押すと、待たずにすぐ繋ぎ直します"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock x:Name="RgbStatus" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== 光り方 ===== -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="光り方" Style="{StaticResource H2}"/>
                            <TextBlock Style="{StaticResource Caption}" Text="LED をどのように光らせるかを選びます。選ぶとすぐに LED に反映されます。"/>
                            <WrapPanel Margin="0,12,0,0">
                                <RadioButton Style="{StaticResource Segment}" GroupName="RgbMode" Content="温度" Margin="0,0,6,6"
                                             ToolTip="CPU や GPU の温度に合わせて、水色（冷えている）→ 緑 → 黄 → 赤（熱い）と色が変わります"
                                             IsChecked="{Binding Rgb.Mode, Converter={StaticResource Equals}, ConverterParameter=Temperature}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="RgbMode" Content="レインボー（流れる）" Margin="0,0,6,6"
                                             ToolTip="虹色が LED の並びに沿ってゆっくり流れます"
                                             IsChecked="{Binding Rgb.Mode, Converter={StaticResource Equals}, ConverterParameter=Rainbow}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="RgbMode" Content="レインボー（固定）" Margin="0,0,6,6"
                                             ToolTip="虹色を LED の並びに沿って並べたまま、動かしません"
                                             IsChecked="{Binding Rgb.Mode, Converter={StaticResource Equals}, ConverterParameter=RainbowStatic}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="RgbMode" Content="呼吸" Margin="0,0,6,6"
                                             ToolTip="選んだ色が、息をするようにゆっくり明るくなったり暗くなったりします"
                                             IsChecked="{Binding Rgb.Mode, Converter={StaticResource Equals}, ConverterParameter=Breathing}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="RgbMode" Content="固定色" Margin="0,0,6,6"
                                             ToolTip="選んだ 1 色で光り続けます"
                                             IsChecked="{Binding Rgb.Mode, Converter={StaticResource Equals}, ConverterParameter=Static}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="RgbMode" Content="音楽連動" Margin="0,0,6,6"
                                             ToolTip="PC で流れている音（スピーカー・ヘッドホンに出ている音）に合わせて光ります。マイクは使いません"
                                             IsChecked="{Binding Rgb.Mode, Converter={StaticResource Equals}, ConverterParameter=Music}"/>
                            </WrapPanel>

                            <!-- 温度 -->
                            <StackPanel Style="{StaticResource RgbTempOnly}" Margin="0,6,0,0">
                                <DockPanel Style="{StaticResource LightRow}">
                                    <TextBlock Text="色を決める温度" Style="{StaticResource RowLabel}"
                                               ToolTip="どのセンサーの温度で色を決めるか。「自動」なら CPU と GPU の高いほうを使います"/>
                                    <ComboBox x:Name="RgbSensorCombo" VerticalAlignment="Center" DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding Rgb.SensorId}"
                                              ToolTip="どのセンサーの温度で色を決めるか。「自動」なら CPU と GPU の高いほうを使います"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource LightRow}">
                                    <TextBlock Text="水色になる温度" Style="{StaticResource RowLabel}" ToolTip="この温度以下では水色（冷えている色）になります"/>
                                    <TextBlock Style="{StaticResource RowValue}" Text="{Binding Rgb.LowTemp, StringFormat={}{0:F0}°C}"/>
                                    <Slider Minimum="20" Maximum="70" Value="{Binding Rgb.LowTemp}" IsSnapToTickEnabled="True" TickFrequency="1"
                                            ToolTip="この温度以下では水色（冷えている色）になります"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource LightRow}">
                                    <TextBlock Text="赤になる温度" Style="{StaticResource RowLabel}" ToolTip="この温度以上で真っ赤（熱い色）になります。間は緑 → 黄と変わります"/>
                                    <TextBlock Style="{StaticResource RowValue}" Text="{Binding Rgb.HighTemp, StringFormat={}{0:F0}°C}"/>
                                    <Slider Minimum="50" Maximum="100" Value="{Binding Rgb.HighTemp}" IsSnapToTickEnabled="True" TickFrequency="1"
                                            ToolTip="この温度以上で真っ赤（熱い色）になります。間は緑 → 黄と変わります"/>
                                </DockPanel>
                            </StackPanel>

                            <!-- 速さ（レインボー・呼吸、音楽連動の「流れる波」） -->
                            <DockPanel x:Name="SpeedRow" Style="{StaticResource LightRow}" Margin="0,6,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="SpeedLabel" Text="速さ" Style="{StaticResource RowLabel}"
                                           ToolTip="レインボーは 1 倍で 1 周 30 秒（3 倍で 10 秒・10 倍で 3 秒）、呼吸は 1 倍で 1 回 6 秒。音楽連動の「流れる波」では流れる速さ"/>
                                <TextBlock Style="{StaticResource RowValue}" Text="{Binding Rgb.Speed, StringFormat={}{0:F1} 倍}"/>
                                <Slider Minimum="0.3" Maximum="10" Value="{Binding Rgb.Speed}" IsSnapToTickEnabled="True" TickFrequency="0.1"
                                        ToolTip="レインボーは 1 倍で 1 周 30 秒（3 倍で 10 秒・10 倍で 3 秒）、呼吸は 1 倍で 1 回 6 秒。音楽連動の「流れる波」では流れる速さ"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- ===== 音楽連動（光り方が「音楽連動」のときだけ） ===== -->
                    <Grid Style="{StaticResource RgbMusicOnly}" Margin="0,0,0,14">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="音楽連動" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="PC から出ている音を分析して、ドラムの瞬間・テンポ・音の高さに合わせて光らせます。まずはプリセットを選び、気になるところだけ下で調整してください。"/>

                                <!-- いまの音（この画面が見えている間だけ動く） -->
                                <Border Background="{DynamicResource InsetBrush}" CornerRadius="12" Padding="14" Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="210"/>
                                        </Grid.ColumnDefinitions>
                                        <ctl:SpectrumView x:Name="LiveSpectrum" Height="104"
                                                          ToolTip="いまの音を、一般的なイコライザーと同じ 10 の帯（31 Hz〜16 kHz）に分けて、低音（左）から高音（右）まで表示しています。中の明るい棒はドラムなどの「立ち上がり」、白い線は少し前までのいちばん高いところです"/>
                                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <ctl:BeatLamp x:Name="BeatLampView" Width="22" Height="22" VerticalAlignment="Center"
                                                              ToolTip="キック（バスドラム）を見つけるたびに光ります。同期テスト中は、クリック音で白く光ります"/>
                                                <TextBlock x:Name="BpmText" Text="—" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"
                                                           ToolTip="曲のテンポ（1 分間の拍の数）。テンポをつかむと、ビートを先読みして遅れなく光らせます"/>
                                            </StackPanel>
                                            <TextBlock x:Name="BeatInfoText" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="LevelText" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                                       ToolTip="音量 = いまの音の大きさ。基準 = 自動の音量調整が「いちばん明るい」とみなしている大きさ（dBFS。0 が最大で、マイナスが大きいほど小さい音）"/>
                                            <TextBlock x:Name="GateText" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                       ToolTip="とても小さな音（雑音）には反応しないようにしています。音が鳴っていないときは、下の「音が止まったとき」の光り方になります"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="AudioStatus" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"/>

                                <!-- プリセット -->
                                <DockPanel Margin="0,16,0,0">
                                    <TextBlock Text="プリセット" Style="{StaticResource RowLabelTop}"
                                               ToolTip="光り方・強さ・色の組み合わせを、まとめておすすめの組み合わせにします。下の設定を自分で変えると「カスタム」になります"/>
                                    <ItemsControl x:Name="PresetChoices" ItemTemplate="{StaticResource ChoiceChipTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </DockPanel>

                                <!-- 音楽の表現（光り方のギャラリー） -->
                                <TextBlock Text="音楽の表現" Style="{StaticResource Label}" Margin="0,12,0,8"
                                           ToolTip="音楽に合わせてどう光らせるか。デバイスごとに変えたいときは、下の「デバイス」で選べます"/>
                                <ItemsControl x:Name="EffectChoices" ItemTemplate="{StaticResource EffectTileTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock x:Name="StrobeNote" Style="{StaticResource Caption}" Margin="0,0,0,4"
                                           Text="「ストロボ」は激しく点滅するため、下の「激しい点滅を抑える」をオフにしたときだけ選べます。"/>

                                <!-- 強さ・色の組み合わせ -->
                                <DockPanel Margin="0,10,0,0">
                                    <TextBlock Text="強さ" Style="{StaticResource RowLabelTop}"
                                               ToolTip="ビートで光る強さと、色が切り替わる間隔。選ぶと、下の「滑らかさ」「メリハリ」「いちばん暗いとき」もその強さに合わせた値になります"/>
                                    <ItemsControl x:Name="IntensityChoices" ItemTemplate="{StaticResource ChoiceChipTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </DockPanel>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock Text="色の組み合わせ" Style="{StaticResource RowLabelTop}"
                                               ToolTip="音楽連動で使う色のセット（パレット）。ビートのたびに、この中の次の色へ切り替わります"/>
                                    <ItemsControl x:Name="PaletteChoices" ItemTemplate="{StaticResource PaletteChipTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </DockPanel>

                                <!-- 反応のしかた -->
                                <StackPanel Margin="0,8,0,0">
                                    <DockPanel Style="{StaticResource LightRow}">
                                        <TextBlock Text="感度" Style="{StaticResource RowLabel}"
                                                   ToolTip="+ にすると、小さな音でも明るく光ります。音が小さい曲や、音量を下げて聴いているとき用。− にすると、大きな音のときだけ明るくなります"/>
                                        <TextBlock Style="{StaticResource RowValue}" Text="{Binding Rgb.Music.GainDb, StringFormat={}{0:+0;-0;0} dB}"/>
                                        <Slider Minimum="-12" Maximum="12" Value="{Binding Rgb.Music.GainDb}" IsSnapToTickEnabled="True" TickFrequency="1"
                                                ToolTip="+ にすると、小さな音でも明るく光ります。音が小さい曲や、音量を下げて聴いているとき用。− にすると、大きな音のときだけ明るくなります"/>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource LightRow}">
                                        <TextBlock Text="反応の感度" Style="{StaticResource RowLabel}"
                                                   ToolTip="ドラムなどの「音の立ち上がり」をどれだけ拾うか。大きいほど小さなドラムの音でもビートとして反応します。反応しすぎてせわしないときは小さくします"/>
                                        <TextBlock Style="{StaticResource RowValue}" Text="{Binding Rgb.Sensitivity, StringFormat={}{0:F1}}"/>
                                        <Slider Minimum="0.5" Maximum="3" Value="{Binding Rgb.Sensitivity}" IsSnapToTickEnabled="True" TickFrequency="0.1"
                                                ToolTip="ドラムなどの「音の立ち上がり」をどれだけ拾うか。大きいほど小さなドラムの音でもビートとして反応します。反応しすぎてせわしないときは小さくします"/>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource LightRow}">
                                        <TextBlock Text="滑らかさ" Style="{StaticResource RowLabel}"
                                                   ToolTip="光が消えていく速さ。大きいほどふわっとゆっくり暗くなり、小さいほどキビキビ動きます"/>
                                        <TextBlock Style="{StaticResource RowValue}" Text="{Binding Rgb.Music.SmoothnessMs, StringFormat={}{0:F0} ms}"/>
                                        <Slider Minimum="60" Maximum="600" Value="{Binding Rgb.Music.SmoothnessMs}" IsSnapToTickEnabled="True" TickFrequency="10"
                                                ToolTip="光が消えていく速さ。大きいほどふわっとゆっくり暗くなり、小さいほどキビキビ動きます"/>
                                    </DockPanel>
                                    <DockPanel x:Name="PunchRow" Style="{StaticResource LightRow}">
                                        <TextBlock Text="メリハリ" Style="{StaticResource RowLabel}"
                                                   ToolTip="大きいほど、ドラムの瞬間だけ強く光り、それ以外は控えめになります。小さいほど、音の大きさに素直に合わせて光ります"/>
                                        <TextBlock Style="{StaticResource RowValue}" Text="{Binding Rgb.Music.Punch, StringFormat={}{0:F0}%}"/>
                                        <Slider Minimum="0" Maximum="100" Value="{Binding Rgb.Music.Punch}" IsSnapToTickEnabled="True" TickFrequency="5"
                                                ToolTip="大きいほど、ドラムの瞬間だけ強く光り、それ以外は控えめになります。小さいほど、音の大きさに素直に合わせて光ります"/>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource LightRow}">
                                        <TextBlock Text="いちばん暗いとき" Style="{StaticResource RowLabel}"
                                                   ToolTip="音が小さいときでも、この明るさまでは光らせておきます。0% にすると、音がないときは真っ暗になります"/>
                                        <TextBlock Style="{StaticResource RowValue}" Text="{Binding Rgb.Music.MinBrightness, StringFormat={}{0:F0}%}"/>
                                        <Slider Minimum="0" Maximum="40" Value="{Binding Rgb.Music.MinBrightness}" IsSnapToTickEnabled="True" TickFrequency="1"
                                                ToolTip="音が小さいときでも、この明るさまでは光らせておきます。0% にすると、音がないときは真っ暗になります"/>
                                    </DockPanel>

                                    <!-- 初期値から変えている値と、初期値に戻すボタン -->
                                    <DockPanel Margin="0,2,0,8">
                                        <Button x:Name="ResetTuningButton" DockPanel.Dock="Right" Style="{StaticResource SmallGhost}" Content="初期値に戻す"
                                                Click="OnResetTuningClick" Padding="10,3" Margin="8,0,0,0" VerticalAlignment="Top"
                                                ToolTip="感度・滑らかさ・メリハリなどの値（下の「詳細」の値も）を初期値に戻します。光り方・強さ・色の組み合わせ・音の遅れの補正はそのままです。右上の「元に戻す」で取り消せます"/>
                                        <TextBlock x:Name="TuningChangedText" Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <!-- 音の遅れの補正と同期テスト -->
                                    <DockPanel Style="{StaticResource LightRow}">
                                        <TextBlock Text="音の遅れの補正" Style="{StaticResource RowLabel}"
                                                   ToolTip="光が音より早いときは + に、遅いときは − にします。Bluetooth のイヤホンやスピーカー、テレビ（HDMI）は音が遅れて聞こえるので + にします。「同期テスト」を使うと合わせやすくなります"/>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Value}" Width="70" TextAlignment="Right"
                                                       Text="{Binding Rgb.Music.AudioDelayMs, StringFormat={}{0:+0;-0;0} ms}"/>
                                            <Button Style="{StaticResource SmallGhost}" Content="−" Tag="-10" Click="OnAudioDelayNudgeClick" Margin="8,0,0,0" Padding="9,3"
                                                    ToolTip="10 ミリ秒だけ光を早めます"/>
                                            <Button Style="{StaticResource SmallGhost}" Content="+" Tag="10" Click="OnAudioDelayNudgeClick" Margin="4,0,0,0" Padding="9,3"
                                                    ToolTip="10 ミリ秒だけ光を遅らせます"/>
                                            <ToggleButton x:Name="SyncTestToggle" Style="{StaticResource ToggleChip}" Content="同期テスト" Click="OnSyncTestClick" Margin="8,0,0,0"
                                                          ToolTip="0.6 秒ごとに「カチッ」という音を鳴らし、LED を白く光らせます。音と光がそろうように「音の遅れの補正」を動かしてください。もう一度押すか、この画面を離れると止まります"/>
                                        </StackPanel>
                                        <Slider Minimum="-100" Maximum="400" Value="{Binding Rgb.Music.AudioDelayMs}" IsSnapToTickEnabled="True" TickFrequency="5"
                                                ToolTip="光が音より早いときは + に、遅いときは − にします。Bluetooth のイヤホンやスピーカー、テレビ（HDMI）は音が遅れて聞こえるので + にします"/>
                                    </DockPanel>
                                    <TextBlock x:Name="SyncTestHelp" Style="{StaticResource Caption}" Foreground="{DynamicResource Accent2Brush}" Margin="170,0,0,6"
                                               Visibility="Collapsed"/>
                                    <!-- 出力先（Bluetooth・HDMI・仮想の出力先）に合わせた、音の遅れの補正の案内（MainWindow.Lighting.cs の UpdateAudioTexts） -->
                                    <StackPanel x:Name="BluetoothHint" Orientation="Horizontal" Margin="170,0,0,6" Visibility="Collapsed">
                                        <TextBlock x:Name="OutputHintText" Style="{StaticResource Caption}" Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" MaxWidth="460" Text="Bluetooth は音が遅れるので +150〜200 ms がおすすめ"/>
                                        <Button x:Name="OutputHintButton" Style="{StaticResource SmallGhost}" Content="+180 ms にする" Click="OnBluetoothDelayClick" Margin="10,0,0,0" Padding="9,3"
                                                VerticalAlignment="Center" ToolTip="音の遅れの補正をこの出力先の目安にします（あとで同期テストで微調整できます）"/>
                                    </StackPanel>
                                    <TextBlock x:Name="OutputSoftwareNote" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="170,0,0,6" Visibility="Collapsed"/>

                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Rgb.Music.ReduceFlashing, Mode=OneWay}" Click="OnReduceFlashingClick" Margin="0,8,0,0"
                                              ToolTip="オンのあいだは、強い点滅を 1 秒に 3 回までにします（光に敏感な方の目や体調を守るため）。ストロボも使いません">
                                        <StackPanel>
                                            <TextBlock Text="激しい点滅を抑える" FontWeight="SemiBold"/>
                                            <TextBlock Text="強い点滅を 1 秒に 3 回までにします。オフにすると「ストロボ」が選べるようになります" Style="{StaticResource Caption}"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <TextBlock x:Name="FlashWarning" Style="{StaticResource Caption}" Foreground="{DynamicResource WarnBrush}" Margin="0,6,0,0" Visibility="Collapsed"
                                               Text="⚠ 激しく点滅することがあります。光の点滅で気分が悪くなったら、すぐに「激しい点滅を抑える」をオンに戻してください。"/>

                                    <!-- テンポ -->
                                    <DockPanel x:Name="TempoRow" Margin="0,12,0,0">
                                        <TextBlock Text="テンポ" Style="{StaticResource RowLabelTop}"
                                                   ToolTip="自動: 曲のテンポをつかんだらビートを先読みして、遅れなく光らせます。キックだけ: 先読みせず、バスドラムが鳴ったときだけ光ります。使わない: テンポもビートも使わず、音の大きさだけで光ります"/>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <TextBlock x:Name="TempoFactorText" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,8,0"/>
                                            <Button x:Name="TempoHalfButton" Style="{StaticResource SmallGhost}" Content="÷2" Click="OnTempoHalfClick" Padding="9,3"
                                                    ToolTip="テンポが実際の 2 倍に取れているとき（せわしなく光るとき）に押すと、半分のテンポで光ります"/>
                                            <Button x:Name="TempoDoubleButton" Style="{StaticResource SmallGhost}" Content="×2" Click="OnTempoDoubleClick" Margin="4,0,0,0" Padding="9,3"
                                                    ToolTip="テンポが実際の半分に取れているとき（ビートの 1 つおきに光るとき）に押すと、2 倍のテンポで光ります"/>
                                        </StackPanel>
                                        <ItemsControl x:Name="TempoChoices" ItemTemplate="{StaticResource ChoiceChipTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </DockPanel>

                                    <!-- 音が止まったとき -->
                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock Text="音が止まったとき" Style="{StaticResource RowLabelTop}"
                                                   ToolTip="音が鳴っていないとき（曲と曲の間・一時停止中など）の光り方。音が戻るとすぐに音楽連動に戻ります"/>
                                        <ItemsControl x:Name="IdleChoices" ItemTemplate="{StaticResource ChoiceChipTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource LightRow}">
                                        <TextBlock Text="切り替えるまで" Style="{StaticResource RowLabel}"
                                                   ToolTip="音が止まってから、「音が止まったとき」の光り方に切り替えるまでの秒数。曲の中の短い無音で切り替わってしまうときは長くします"/>
                                        <TextBlock Style="{StaticResource RowValue}" Text="{Binding Rgb.Music.IdleDelaySec, StringFormat={}{0:F0} 秒}"/>
                                        <Slider Minimum="1" Maximum="10" Value="{Binding Rgb.Music.IdleDelaySec}" IsSnapToTickEnabled="True" TickFrequency="1"
                                                ToolTip="音が止まってから、「音が止まったとき」の光り方に切り替えるまでの秒数。曲の中の短い無音で切り替わってしまうときは長くします"/>
                                    </DockPanel>

                                    <!-- 反応する音 -->
                                    <DockPanel Style="{StaticResource LightRow}">
                                        <TextBlock Text="反応する音" Style="{StaticResource RowLabel}"
                                                   ToolTip="空欄なら PC から出ているすべての音に反応します。アプリ名（例: Spotify）を入れると、そのアプリの音が鳴っているときだけ反応します"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBox x:Name="MusicSourceBox" Width="190" Text="{Binding Rgb.MusicSource}"
                                                     ToolTip="空欄ならすべての音。アプリ名（例: Spotify）を入れると、そのアプリの音が鳴っているときだけ反応します"/>
                                            <Button Style="{StaticResource SmallGhost}" Content="音を出しているアプリから選ぶ ▾" Click="OnPickMusicAppClick" Margin="8,0,0,0"
                                                    ToolTip="いま音を出している（または出せる）アプリの一覧から選びます。音が出ているアプリが上に並びます"/>
                                            <Button Style="{StaticResource SmallGhost}" Content="すべての音" Click="OnAllSoundsClick" Margin="6,0,0,0"
                                                    ToolTip="アプリを指定せず、PC から出ているすべての音に反応します"/>
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>

                                <!-- 詳しい設定 -->
                                <ToggleButton x:Name="MusicDetailToggle" Style="{StaticResource ToggleChip}" Content="詳しい設定（上級者向け）" HorizontalAlignment="Left" Margin="0,12,0,0"
                                              ToolTip="音の分析の細かな設定を表示します。ふつうは変えなくて大丈夫です"/>
                                <StackPanel Margin="0,8,0,0" Visibility="{Binding IsChecked, ElementName=MusicDetailToggle, Converter={StaticResource BoolToVis}}">
                                    <DockPanel Style="{StaticResource LightRow}">
                                        <TextBlock Text="反応の速さ" Style="{StaticResource RowLabel}"
                                                   ToolTip="音が大きくなったとき、光が明るくなるまでの時間。0 にすると最速ですが、チラつきやすくなります"/>
                                        <TextBlock Style="{StaticResource RowValue}" Text="{Binding Rgb.Music.ReactionMs, StringFormat={}{0:F0} ms}"/>
                                        <Slider Minimum="0" Maximum="40" Value="{Binding Rgb.Music.ReactionMs}" IsSnapToTickEnabled="True" TickFrequency="1"
                                                ToolTip="音が大きくなったとき、光が明るくなるまでの時間。0 にすると最速ですが、チラつきやすくなります"/>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource LightRow}">
                                        <TextBlock Text="明るさに使う音量の幅" Style="{StaticResource RowLabel}"
                                                   ToolTip="いちばん大きな音から何 dB 小さい音までを、明るさの違いとして表すか。小さくすると明暗がはっきりし、大きくすると小さな音にも反応します"/>
                                        <TextBlock Style="{StaticResource RowValue}" Text="{Binding Rgb.Music.DynamicRangeDb, StringFormat={}{0:F0} dB}"/>
                                        <Slider Minimum="24" Maximum="60" Value="{Binding Rgb.Music.DynamicRangeDb}" IsSnapToTickEnabled="True" TickFrequency="1"
                                                ToolTip="いちばん大きな音から何 dB 小さい音までを、明るさの違いとして表すか。小さくすると明暗がはっきりし、大きくすると小さな音にも反応します"/>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource LightRow}">
                                        <TextBlock Text="音の高さのバランス" Style="{StaticResource RowLabel}"
                                                   ToolTip="低音ばかり・高音ばかりの曲でも、すべての帯がほどよく光るように自動でならす強さ。0% にすると、曲の音のバランスをそのまま表します"/>
                                        <TextBlock Style="{StaticResource RowValue}" Text="{Binding Rgb.Music.AutoBalance, StringFormat={}{0:F0}%}"/>
                                        <Slider Minimum="0" Maximum="100" Value="{Binding Rgb.Music.AutoBalance}" IsSnapToTickEnabled="True" TickFrequency="5"
                                                ToolTip="低音ばかり・高音ばかりの曲でも、すべての帯がほどよく光るように自動でならす強さ。0% にすると、曲の音のバランスをそのまま表します"/>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource LightRow}">
                                        <TextBlock Text="高音の持ち上げ" Style="{StaticResource RowLabel}"
                                                   ToolTip="高い音ほど強めに扱う量（1 オクターブ上がるごとに何 dB 足すか）。ハイハットなどの高音にもっと反応させたいときは大きくします"/>
                                        <TextBlock Style="{StaticResource RowValue}" Text="{Binding Rgb.Music.TrebleTilt, StringFormat={}{0:F1} dB/oct}"/>
                                        <Slider Minimum="0" Maximum="4.5" Value="{Binding Rgb.Music.TrebleTilt}" IsSnapToTickEnabled="True" TickFrequency="0.5"
                                                ToolTip="高い音ほど強めに扱う量（1 オクターブ上がるごとに何 dB 足すか）。ハイハットなどの高音にもっと反応させたいときは大きくします"/>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource LightRow}">
                                        <TextBlock Text="コントラスト" Style="{StaticResource RowLabel}"
                                                   ToolTip="大きいほど、強い音だけがくっきり明るくなり、弱い音は暗めになります。1.0 で変えません"/>
                                        <TextBlock Style="{StaticResource RowValue}" Text="{Binding Rgb.Music.Contrast, StringFormat={}{0:F2}}"/>
                                        <Slider Minimum="0.7" Maximum="2" Value="{Binding Rgb.Music.Contrast}" IsSnapToTickEnabled="True" TickFrequency="0.05"
                                                ToolTip="大きいほど、強い音だけがくっきり明るくなり、弱い音は暗めになります。1.0 で変えません"/>
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ===== 色と明るさ ===== -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="色と明るさ" Style="{StaticResource H2}"/>
                            <StackPanel x:Name="ColorRow" Margin="0,12,0,0">
                                <DockPanel Style="{StaticResource LightRow}">
                                    <TextBlock Text="色" Style="{StaticResource RowLabel}"
                                               ToolTip="固定色・呼吸の色。音楽連動では、色の組み合わせ「選んだ色」のときの中心の色になります"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ItemsControl x:Name="ColorSwatches" ItemTemplate="{StaticResource SwatchTemplate}" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <Ellipse x:Name="CurrentColorDot" Width="22" Height="22" Margin="10,0,0,0" Stroke="{DynamicResource TextBrush}" StrokeThickness="2"
                                                 VerticalAlignment="Center" ToolTip="いま選んでいる色"/>
                                        <TextBox x:Name="HexColorBox" Width="96" Margin="8,0,0,0" VerticalAlignment="Center"
                                                 TextChanged="OnHexColorChanged" LostFocus="OnHexColorLostFocus" KeyDown="OnHexColorKeyDown"
                                                 ToolTip="#RRGGBB の形で色を入力できます（例: #6A00FF）。左の丸から選んでも構いません"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock x:Name="HexColorError" Style="{StaticResource Caption}" Foreground="{DynamicResource DangerBrush}" Margin="170,0,0,6"
                                           Visibility="Collapsed" Text="#RRGGBB の形で入力してください（例: #6A00FF）。0〜9 と A〜F の 6 文字です"/>
                            </StackPanel>
                            <DockPanel Style="{StaticResource LightRow}" Margin="0,4,0,0">
                                <TextBlock Text="明るさ" Style="{StaticResource RowLabel}" ToolTip="LED 全体の明るさ。どの光り方でも、この明るさを上限にします"/>
                                <TextBlock Style="{StaticResource RowValue}" Text="{Binding Rgb.Brightness, StringFormat={}{0:F0}%}"/>
                                <Slider Minimum="10" Maximum="100" Value="{Binding Rgb.Brightness}" IsSnapToTickEnabled="True" TickFrequency="5"
                                        ToolTip="LED 全体の明るさ。どの光り方でも、この明るさを上限にします"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- ===== デバイス ===== -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="デバイス" Style="{StaticResource H2}"/>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="OpenRGB で見つかった LED のデバイスです。下の帯は、いま送っている色のプレビューです。"/>
                            <CheckBox x:Name="AllDevicesSwitch" Style="{StaticResource Switch}" Margin="0,14,0,0" Click="OnAllRgbDevicesClick"
                                      ToolTip="オンなら、OpenRGB で見つかったすべてのデバイス（あとから増えたものも含む）の色を変えます。オフにすると、色を変えるデバイスを選べます">
                                <StackPanel>
                                    <TextBlock Text="すべてのデバイスの色を変える" FontWeight="SemiBold"/>
                                    <TextBlock Text="オフにすると、下でデバイスごとに選べます" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="WhiteTestSwitch" Style="{StaticResource Switch}" Margin="0,12,0,0" Click="OnWhiteTestClick"
                                      ToolTip="色合わせ用。全部のデバイスを同じ白で光らせます（デバイス・ゾーンの色合わせと明るさは掛けます）。この画面を離れると元に戻ります">
                                <StackPanel>
                                    <TextBlock Text="白く光らせて見比べる" FontWeight="SemiBold"/>
                                    <TextBlock Text="色合わせのとき、全部のデバイスを同じ白にします（この画面を離れると戻ります）" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </CheckBox>
                            <TextBlock x:Name="RgbDeviceHint" Style="{StaticResource Caption}" Foreground="{DynamicResource WarnBrush}" Margin="0,8,0,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="RgbDevicesEmpty" Style="{StaticResource Caption}" Margin="0,12,0,0"
                                       Text="デバイスの一覧は、OpenRGB に接続すると表示されます（上の「接続テスト」でも読み込めます）。"/>
                            <ItemsControl x:Name="RgbDevices" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource RowBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                               ToolTip="fps = 1 秒に色を送っている回数 ・ いま使っている音楽連動の光り方"/>
                                                    <CheckBox Style="{StaticResource DeviceCheck}" IsChecked="{Binding Selected}" IsEnabled="{Binding CanSelect}" Click="OnRgbDeviceClick"
                                                              ToolTip="チェックしたデバイスの色を変えます（「すべてのデバイスの色を変える」がオンのときは全部が対象です）">
                                                        <TextBlock>
                                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                            <Run Text="{Binding LedText, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                                        </TextBlock>
                                                    </CheckBox>
                                                    <Border Style="{StaticResource SoftBadge}" HorizontalAlignment="Left"
                                                            Visibility="{Binding IsSlow, Converter={StaticResource BoolToVis}}"
                                                            ToolTip="{Binding SlowBadgeTip, Mode=OneWay}">
                                                        <TextBlock Text="{Binding SlowBadgeText, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource WarnBrush}"/>
                                                    </Border>
                                                </DockPanel>
                                                <ctl:LedPreview Height="12" Margin="24,8,0,0" Loaded="OnLedPreviewLoaded" Unloaded="OnLedPreviewUnloaded"
                                                                ToolTip="このデバイスに最後に送った色（画面の色に近づけて表示しています）"/>
                                                <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Caption}" Foreground="{DynamicResource DangerBrush}" Margin="24,4,0,0"
                                                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                                                <WrapPanel Margin="24,8,0,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,4" Visibility="{Binding ShowEffect, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="光り方" Style="{StaticResource Label}" FontSize="13" Margin="0,0,8,0"/>
                                                        <ComboBox Width="170" ItemsSource="{Binding EffectOptions}" DisplayMemberPath="Label" SelectedValuePath="Id"
                                                                  SelectedValue="{Binding Effect}"
                                                                  ToolTip="このデバイスだけ音楽連動の光り方を変えます。「自動」なら上の「音楽の表現」を使います（更新が遅いデバイスは、滑らかな光り方に自動で置き換えます）"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                                        <TextBlock Text="左右対称" Style="{StaticResource Label}" FontSize="13" Margin="0,0,8,0"/>
                                                        <ComboBox Width="150" ItemsSource="{Binding MirrorOptions}" DisplayMemberPath="Label" SelectedValuePath="Id"
                                                                  SelectedValue="{Binding MirrorId}"
                                                                  ToolTip="LED の並びの真ん中から左右対称に光らせます（長い LED テープ向け）。「自動」なら LED が 30 個以上のまとまりでオンになります"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,4"
                                                                Visibility="{Binding ShowFps, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="1 秒に送る回数" Style="{StaticResource Label}" FontSize="13" Margin="0,0,8,0"/>
                                                        <ComboBox Width="90" ItemsSource="{Binding FpsOptions}" DisplayMemberPath="Label" SelectedValuePath="Id"
                                                                  SelectedValue="{Binding FpsId}"
                                                                  ToolTip="このデバイスに色を送る回数の上限です。多いほど動きが滑らかになりますが、グラボやメモリでは多すぎると一部しか書き換わらず、ちかちかすることがあります。ちかちかしない範囲で上げてください"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                                        <TextBlock Text="早めに光らせる" Style="{StaticResource Label}" FontSize="13" Margin="0,0,8,0"/>
                                                        <ComboBox Width="100" ItemsSource="{Binding LeadOptions}" DisplayMemberPath="Label" SelectedValuePath="Id"
                                                                  SelectedValue="{Binding LeadId}"
                                                                  ToolTip="このデバイスだけ、音楽連動の色の切り替えを早めます。ほかのデバイスより遅れて見えるときに増やしてください（グラボなど、色が反映されるまで時間がかかる機器向け）。テンポをつかんでいる（予測できる）ビートで効きます。「自動」は USB 8 ミリ秒・メモリなど 20 ミリ秒・グラボ 60 ミリ秒"/>
                                                    </StackPanel>
                                                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding AnimateOnGpu}" Margin="0,4,18,4"
                                                              Visibility="{Binding ShowAnimateOnGpu, Converter={StaticResource BoolToVis}}"
                                                              ToolTip="オフ（おすすめ）: グラボは、レインボー（流れる）を止まった虹に、呼吸を固定色にします。グラボは LED を 1 個ずつ書き込むため、動かし続けるとちかちかしやすいからです。オンにすると、グラボも流れ・呼吸します">
                                                        <TextBlock Text="虹・呼吸も動かす" FontSize="13" Foreground="{DynamicResource SubTextBrush}"/>
                                                    </CheckBox>
                                                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Reverse}" Margin="0,4,18,4"
                                                              ToolTip="LED の並びを逆向きにします（流れる向きや、低音・高音の並びが逆に見えるとき）">
                                                        <TextBlock Text="逆向き" FontSize="13" Foreground="{DynamicResource SubTextBrush}"/>
                                                    </CheckBox>
                                                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding SwapRedGreen}" Margin="0,4,0,4"
                                                              ToolTip="水色がピンクに、緑が赤に見えるときにオンにします（色の並び順が逆のデバイス用）">
                                                        <TextBlock Text="赤と緑を入れ替える" FontSize="13" Foreground="{DynamicResource SubTextBrush}"/>
                                                    </CheckBox>
                                                </WrapPanel>
                                                <CheckBox Style="{StaticResource Check}" IsChecked="{Binding ShowDetails}" Margin="24,4,0,0"
                                                          ToolTip="このデバイスの色味・明るさを合わせたり、マザーボードの端子（ゾーン）ごとに光り方・向き・色味を変えたりします">
                                                    <TextBlock Text="色合わせ・ゾーンごとの設定を開く" FontSize="13" Foreground="{DynamicResource SubTextBrush}"/>
                                                </CheckBox>
                                                <StackPanel Margin="24,8,0,0" Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="色合わせ（このデバイス全体）" FontWeight="SemiBold" FontSize="13"/>
                                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,6"
                                                               Text="同じ色を送っても、LED によって色味や明るさが違って見えます。上の「白く光らせて見比べる」をオンにして、白がそろうように赤・緑・青を下げてください（上げることはできないので、強すぎる色を下げます）"/>
                                                    <UniformGrid Columns="4">
                                                        <StackPanel Margin="0,0,12,0">
                                                            <TextBlock FontSize="13"><Run Text="赤 "/><Run Text="{Binding GainR, Mode=OneWay}"/><Run Text="%"/></TextBlock>
                                                            <Slider Minimum="0" Maximum="100" Value="{Binding GainR}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,12,0">
                                                            <TextBlock FontSize="13"><Run Text="緑 "/><Run Text="{Binding GainG, Mode=OneWay}"/><Run Text="%"/></TextBlock>
                                                            <Slider Minimum="0" Maximum="100" Value="{Binding GainG}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,12,0">
                                                            <TextBlock FontSize="13"><Run Text="青 "/><Run Text="{Binding GainB, Mode=OneWay}"/><Run Text="%"/></TextBlock>
                                                            <Slider Minimum="0" Maximum="100" Value="{Binding GainB}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock FontSize="13"><Run Text="明るさ "/><Run Text="{Binding Level, Mode=OneWay}"/><Run Text="%"/></TextBlock>
                                                            <Slider Minimum="0" Maximum="100" Value="{Binding Level}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                                        </StackPanel>
                                                    </UniformGrid>
                                                    <TextBlock Text="ゾーン（端子）ごとの設定" FontWeight="SemiBold" FontSize="13" Margin="0,12,0,0"
                                                               Visibility="{Binding HasZones, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,6"
                                                               Visibility="{Binding HasZones, Converter={StaticResource BoolToVis}}"
                                                               Text="マザーボードの端子ごとに、つないだ物（ファン・電源・水冷のヘッドなど）に合わせて光り方・向き・色味を変えられます。「デバイスと同じ」なら上の設定のままです。同じ端子に数珠つなぎにした物は、まとめて 1 つのゾーンです"/>
                                                    <ItemsControl ItemsSource="{Binding Zones}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{DynamicResource Inset2Brush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                                                    <StackPanel>
                                                                        <TextBlock>
                                                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                                            <Run Text="{Binding LedText, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                                                        </TextBlock>
                                                                        <WrapPanel Margin="0,6,0,0">
                                                                            <StackPanel Orientation="Horizontal" Margin="0,0,18,4" Visibility="{Binding ShowEffect, Converter={StaticResource BoolToVis}}">
                                                                                <TextBlock Text="光り方" Style="{StaticResource Label}" FontSize="13" Margin="0,0,8,0"/>
                                                                                <ComboBox Width="170" ItemsSource="{Binding EffectOptions}" DisplayMemberPath="Label" SelectedValuePath="Id"
                                                                                          SelectedValue="{Binding EffectId}"
                                                                                          ToolTip="このゾーンだけ音楽連動の光り方を変えます（例: ラジエーターのファンは音量メーター、電源はビートで色替え）"/>
                                                                            </StackPanel>
                                                                            <StackPanel Orientation="Horizontal" Margin="0,0,18,4" Visibility="{Binding ShowEffect, Converter={StaticResource BoolToVis}}">
                                                                                <TextBlock Text="反応する音" Style="{StaticResource Label}" FontSize="13" Margin="0,0,8,0"/>
                                                                                <ComboBox Width="190" ItemsSource="{Binding SoundOptions}" DisplayMemberPath="Label" SelectedValuePath="Id"
                                                                                          SelectedValue="{Binding SoundId}"
                                                                                          ToolTip="光り方「パーツごとの役割」のとき、このゾーンがどの音で光るか。「パーツに合わせる」なら、ファンは低音・グラボは中音・メモリやキーボードは高音"/>
                                                                            </StackPanel>
                                                                            <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                                                                <TextBlock Text="左右対称" Style="{StaticResource Label}" FontSize="13" Margin="0,0,8,0"/>
                                                                                <ComboBox Width="130" ItemsSource="{Binding MirrorOptions}" DisplayMemberPath="Label" SelectedValuePath="Id"
                                                                                          SelectedValue="{Binding MirrorId}"/>
                                                                            </StackPanel>
                                                                            <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                                                                <TextBlock Text="向き" Style="{StaticResource Label}" FontSize="13" Margin="0,0,8,0"/>
                                                                                <ComboBox Width="130" ItemsSource="{Binding ReverseOptions}" DisplayMemberPath="Label" SelectedValuePath="Id"
                                                                                          SelectedValue="{Binding ReverseId}"/>
                                                                            </StackPanel>
                                                                        </WrapPanel>
                                                                        <UniformGrid Columns="4" Margin="0,4,0,0">
                                                                            <StackPanel Margin="0,0,12,0">
                                                                                <TextBlock FontSize="13"><Run Text="赤 "/><Run Text="{Binding GainR, Mode=OneWay}"/><Run Text="%"/></TextBlock>
                                                                                <Slider Minimum="0" Maximum="100" Value="{Binding GainR}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                                                            </StackPanel>
                                                                            <StackPanel Margin="0,0,12,0">
                                                                                <TextBlock FontSize="13"><Run Text="緑 "/><Run Text="{Binding GainG, Mode=OneWay}"/><Run Text="%"/></TextBlock>
                                                                                <Slider Minimum="0" Maximum="100" Value="{Binding GainG}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                                                            </StackPanel>
                                                                            <StackPanel Margin="0,0,12,0">
                                                                                <TextBlock FontSize="13"><Run Text="青 "/><Run Text="{Binding GainB, Mode=OneWay}"/><Run Text="%"/></TextBlock>
                                                                                <Slider Minimum="0" Maximum="100" Value="{Binding GainB}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                                                            </StackPanel>
                                                                            <StackPanel>
                                                                                <TextBlock FontSize="13"><Run Text="明るさ "/><Run Text="{Binding Level, Mode=OneWay}"/><Run Text="%"/></TextBlock>
                                                                                <Slider Minimum="0" Maximum="100" Value="{Binding Level}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                                                            </StackPanel>
                                                                        </UniformGrid>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="MissingDevicesText" Style="{StaticResource Caption}" Margin="0,4,0,0" Visibility="Collapsed"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="ヒント: 何もつないでいないマザーボードの ARGB 端子は、OpenRGB の Devices →（マザーボード）→「Edit Device」で LED の数を 0 にしておくと、送るデータが減って動きが滑らかになります。左右対称・逆向きは、LED の並びを使う光り方（スペクトラム・音量メーターなど）で効きます。"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== ケースの中の配置 ===== -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="ケースの中の配置" Style="{StaticResource H2}"/>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="ファン・グラボ・メモリ・テープなどが、ケースの中のどこにあるかを選ぶと、波・虹・音量メーター・波紋などがデバイスをまたいで、ケース全体で 1 つにつながって流れます。場所を決めていない LED（キーボードなど）は、これまでどおりデバイスの中の並びで光ります"/>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Rgb.CaseLayout}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="ケースの中の位置に合わせて光を流す" FontWeight="SemiBold"/>
                                    <TextBlock Text="オフにすると、場所を選んであっても、デバイスごとの並びで光ります" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </CheckBox>
                            <DockPanel Style="{StaticResource LightRow}" Margin="0,12,0,0">
                                <TextBlock Text="光が流れる向き" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="CaseDirectionCombo" Width="240" HorizontalAlignment="Left" DisplayMemberPath="Label" SelectedValuePath="Id"
                                          SelectedValue="{Binding Rgb.CaseDirection}"
                                          ToolTip="波・虹が流れる向き、音量メーターが伸びる向き、波紋が広がる向きです（ケースを横のガラスから見たとき）"/>
                            </DockPanel>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource Inset2Brush}" CornerRadius="10" Padding="12" VerticalAlignment="Top" Margin="0,0,16,0">
                                    <StackPanel>
                                        <ctl:CasePreview x:Name="CasePreviewView" Width="340" Loaded="OnCasePreviewLoaded"
                                                         ToolTip="ケースを横から見た絵です。場所を決めた LED に、最後に送った色を表示します"/>
                                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Width="340" Margin="0,8,0,0"
                                                   Text="横のガラスから見た絵です（左が背面、右が前面）。「ケースの中の位置に合わせて光を流す」がオンのときに表示します"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="CasePlacesEmpty" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                               Text="デバイスの一覧は、OpenRGB に接続すると表示されます。"/>
                                    <ItemsControl x:Name="CasePlaceList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource RowBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <TextBlock TextWrapping="Wrap">
                                                            <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/>
                                                            <Run Text="{Binding LedText, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                                        </TextBlock>
                                                        <ComboBox Margin="0,6,0,0" MaxWidth="420" HorizontalAlignment="Left" MinWidth="280"
                                                                  ItemsSource="{Binding PlaceOptions}" DisplayMemberPath="Label" SelectedValuePath="Id"
                                                                  SelectedValue="{Binding PlaceId}"
                                                                  ToolTip="このゾーンの LED がケースの中のどこにあるか。数珠つなぎのファンは「3 つ（上から順）」など、つないだ順を選んでください"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ===== 詳細 ===== -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="詳細" Style="{StaticResource H2}"/>
                            <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Rgb.Gamma}" Margin="0,14,0,0"
                                      Content="色を濃く見せる（ガンマ補正。オフにすると明るく淡い色になります）"
                                      ToolTip="LED は暗い成分もそのまま光るので、画面で見る色より白っぽく見えます。オンにすると画面の色に近い濃い色になり、明るさの変化も目で見て滑らかになります"/>
                            <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Rgb.BlinkOnEmergency}" Margin="0,8,0,0"
                                      Content="緊急全開のときは赤く点滅させる（どの光り方でも優先）"
                                      ToolTip="温度が上限に達してファンを全開にしたとき、どの光り方を選んでいても LED を赤く点滅させてお知らせします"/>
                            <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Rgb.DirectGpuWrite}" Margin="0,8,0,0"
                                      Content="対応しているグラボは OpenRGB を通さず直接光らせる（PNY ARGB Epic-X。ほかの LED と遅れずに光ります）"
                                      ToolTip="OpenRGB は PNY のグラボの LED を 1 個ずつ書くので、色が変わるたびに約 35 ミリ秒かかり、ほかの LED より遅れます。オンにすると、アプリが NVIDIA のドライバーを通して直接書きます。書き込みに失敗し続けたときは、自動で OpenRGB を通す方法に戻ります"/>
                            <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Rgb.DirectGpuUnverified}" Margin="24,6,0,0"
                                      IsEnabled="{Binding Rgb.DirectGpuWrite}"
                                      Content="確かめていない型番のグラボにも直接書き込む（試すときだけ）"
                                      ToolTip="直接書き込みを実機で確かめたのは RTX 5070 Ti だけです。同じ PNY ARGB Epic-X の別の型番（LED の並びが同じもの）にも試すときにオンにします。色がおかしいときはオフに戻してください"/>
                            <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Rgb.MatchSlowDevices}" Margin="0,8,0,0"
                                      Content="音楽連動で、グラボ・メモリなど更新の遅いデバイスは、ほかのデバイスの色に合わせる"
                                      ToolTip="グラボやメモリは 1 秒に 4〜8 回しか色を変えられないので、スペクトラム・音量メーターなどの細かい動きは出せません。オンにすると、ファンなど速いデバイスがいま光っている色の平均に合わせて光るので、色がそろって見えます。デバイスごとに光り方を選んだデバイスは、選んだ光り方のままです"/>
                            <TextBlock x:Name="SmbusWarning" Style="{StaticResource Caption}" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap"
                                       Margin="0,10,0,0" Visibility="Collapsed"/>
                            <DockPanel Style="{StaticResource LightRow}" Margin="0,8,0,0">
                                <TextBlock Text="止めるときの LED" Style="{StaticResource RowLabel}"
                                           ToolTip="連携をオフにしたとき・アプリを終了するとき・スリープするときに、LED をどうするか"/>
                                <ComboBox x:Name="OnStopCombo" Width="260" HorizontalAlignment="Left" VerticalAlignment="Center" DisplayMemberPath="Label" SelectedValuePath="Id"
                                          SelectedValue="{Binding Rgb.OnStop}"
                                          ToolTip="連携をオフにしたとき・アプリを終了するとき・スリープするときに、LED をどうするか。「そのまま」は最後の色のまま止まります"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= 設定 ================= -->
            <ScrollViewer x:Name="SettingsPage" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="36,0,36,30" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <RadioButton x:Name="SetTabGeneral" Style="{StaticResource Segment}" Content="一般" GroupName="SettingsTab" IsChecked="True" Checked="OnSettingsTabChanged"/>
                        <RadioButton x:Name="SetTabAuto" Style="{StaticResource Segment}" Content="プロファイル・自動化" GroupName="SettingsTab" Checked="OnSettingsTabChanged"/>
                        <RadioButton x:Name="SetTabLink" Style="{StaticResource Segment}" Content="通知・連携" GroupName="SettingsTab" Checked="OnSettingsTabChanged"/>
                        <RadioButton x:Name="SetTabSafety" Style="{StaticResource Segment}" Content="安全・バックアップ" GroupName="SettingsTab" Checked="OnSettingsTabChanged"/>
                    </StackPanel>

                    <StackPanel x:Name="SettingsGeneral">
                        <!-- 起動 -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="起動と表示" Style="{StaticResource H2}"/>
                                <CheckBox x:Name="AutoStartSwitch" Style="{StaticResource Switch}" Margin="0,16,0,0" Click="OnAutoStartClick">
                                    <StackPanel>
                                        <TextBlock Text="Windows ログオン時に自動で起動する" FontWeight="SemiBold"/>
                                        <TextBlock Text="タスクスケジューラに「最上位の特権」で登録します（UAC の確認なしで起動）" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartMinimized}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="手動で起動したときもタスクトレイに格納する" FontWeight="SemiBold"/>
                                        <TextBlock Text="自動起動のときは常にタスクトレイで起動します。ウィンドウの × で閉じてもトレイで動き続けます" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="WidgetSwitch" Style="{StaticResource Switch}" Margin="0,16,0,0" Click="OnWidgetSwitchClick">
                                    <StackPanel>
                                        <TextBlock Text="ミニウィジェットを表示する" FontWeight="SemiBold"/>
                                        <TextBlock Text="常に最前面に温度と回転数を表示します。ドラッグで移動、右クリックで不透明度を変更できます" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <!-- 見た目 -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="見た目" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="表示言語・テーマ・アクセント色・背景色・文字色・フォント・文字の大きさを変えられます。変えるとすぐに反映されます"/>
                                <!-- 表示言語（読めない言語になっていても探せるよう、見出しに英語も添える。MainWindow.Settings.cs） -->
                                <DockPanel Style="{StaticResource LightRow}" Margin="0,14,0,0">
                                    <TextBlock Text="表示言語 · Language" Style="{StaticResource RowLabel}"/>
                                    <ComboBox x:Name="LanguageCombo" Width="320" HorizontalAlignment="Left" DisplayMemberPath="Label" SelectedValuePath="Id"
                                              SelectionChanged="OnLanguageChanged"
                                              ToolTip="画面の言葉の言語。「自動」なら Windows の表示言語に合わせます（対応していない言語なら英語）。選ぶとすぐに切り替わります"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource LightRow}" Margin="0,8,0,0">
                                    <TextBlock Text="テーマ" Style="{StaticResource RowLabel}"/>
                                    <ComboBox x:Name="ThemeCombo" Width="240" HorizontalAlignment="Left" DisplayMemberPath="Label" SelectedValuePath="Id"
                                              SelectedValue="{Binding Appearance.Theme}"
                                              ToolTip="「Windows に合わせる」なら、Windows の設定（個人用設定 → 色 → アプリ モード）のダーク／ライトに合わせます"/>
                                </DockPanel>
                                <TextBlock Text="アクセント色" Style="{StaticResource Label}" Margin="0,12,0,6"/>
                                <WrapPanel Margin="0,0,0,6">
                                    <Button x:Name="AccentDefaultButton" Style="{StaticResource SmallGhost}" Content="既定（紫）" Margin="0,0,8,0" Click="OnAccentDefaultClick"/>
                                    <Button x:Name="AccentSystemButton" Style="{StaticResource SmallGhost}" Content="Windows の色に合わせる" Click="OnAccentSystemClick"
                                            ToolTip="Windows の設定（個人用設定 → 色 → アクセント カラー）の色を使います"/>
                                </WrapPanel>
                                <ItemsControl x:Name="AccentSwatches" ItemTemplate="{StaticResource SwatchTemplate}" MaxWidth="640" HorizontalAlignment="Left">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock Text="背景色" Style="{StaticResource Label}" Margin="0,12,0,2"/>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Text="背景・サイドバー・カードをまとめて染めます。ダークでは暗い色、ライトでは明るい色になり、テーマを替えても色合いは同じです"/>
                                <WrapPanel Margin="0,0,0,6">
                                    <Button x:Name="BackgroundDefaultButton" Style="{StaticResource SmallGhost}" Content="既定" Click="OnBackgroundDefaultClick"/>
                                </WrapPanel>
                                <ItemsControl x:Name="BackgroundSwatches" ItemTemplate="{StaticResource BackgroundSwatchTemplate}" MaxWidth="640" HorizontalAlignment="Left">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock Text="文字色" Style="{StaticResource Label}" Margin="0,12,0,2"/>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Text="画面のすべての文字の色です（補足の文字やグラフの目盛りも、同じ色合いで少し薄くなります）。ダークでは明るい色、ライトでは暗い色になり、どの背景でも読めます"/>
                                <WrapPanel Margin="0,0,0,6">
                                    <Button x:Name="TextColorDefaultButton" Style="{StaticResource SmallGhost}" Content="既定" Click="OnTextColorDefaultClick"/>
                                </WrapPanel>
                                <ItemsControl x:Name="TextColorSwatches" ItemTemplate="{StaticResource SwatchTemplate}" MaxWidth="640" HorizontalAlignment="Left">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <DockPanel Style="{StaticResource LightRow}" Margin="0,12,0,0">
                                    <TextBlock Text="フォント" Style="{StaticResource RowLabel}"/>
                                    <ComboBox x:Name="FontCombo" Width="440" HorizontalAlignment="Left" DisplayMemberPath="Label" SelectedValuePath="Id"
                                              SelectedValue="{Binding Appearance.FontFamily}" IsTextSearchEnabled="True"
                                              ToolTip="画面の文字のフォント。日本語の文字がないフォントでは、日本語は Yu Gothic UI で表示します"/>
                                </DockPanel>
                                <TextBlock x:Name="FontPreview" Text="あいうえお 温度とファン ABC 123 °C" FontSize="16" Margin="170,6,0,0"
                                           Foreground="{DynamicResource SubTextBrush}"/>
                                <DockPanel Style="{StaticResource LightRow}" Margin="0,8,0,0">
                                    <TextBlock Text="文字の大きさ" Style="{StaticResource RowLabel}"/>
                                    <TextBlock Style="{StaticResource RowValue}" Text="{Binding Appearance.TextScale, StringFormat={}{0}%}"/>
                                    <Slider Minimum="85" Maximum="130" Value="{Binding Appearance.TextScale}" IsSnapToTickEnabled="True" TickFrequency="5"
                                            ToolTip="画面全体（文字・ボタン・グラフ）を拡大・縮小します"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- 制御 -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="制御" Style="{StaticResource H2}"/>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding DryRun}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="DRY RUN（テストモード）" FontWeight="SemiBold"/>
                                        <TextBlock Text="計算結果を表示するだけで、ファンには書き込みません（ポンプの回転が落ちたときの保護運転と、自分で始めた識別・測定・一時指定だけは書き込みます）" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="36"/>
                                        <RowDefinition Height="36"/>
                                        <RowDefinition Height="36"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="更新間隔" Style="{StaticResource Label}"/>
                                    <Slider Grid.Column="1" Minimum="250" Maximum="3000" Value="{Binding PollingIntervalMs}" IsSnapToTickEnabled="True" TickFrequency="250"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{Binding PollingIntervalMs, StringFormat={}{0} ms}"/>

                                    <TextBlock Grid.Row="1" Text="緊急全開（CPU・その他）" Style="{StaticResource Label}"
                                               ToolTip="カーブで使っているどれかのセンサーがこの温度に達すると、全ファンを 100% にします"/>
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="80" Maximum="110" Value="{Binding EmergencyTemperature}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding EmergencyTemperature, StringFormat={}{0:F0}°C}"/>

                                    <TextBlock Grid.Row="2" Text="緊急全開（GPU Hot Spot）" Style="{StaticResource Label}"
                                               ToolTip="Hot Spot は GPU 内でいちばん熱い点で、Edge より 10〜20°C 高く出ます"/>
                                    <Slider Grid.Row="2" Grid.Column="1" Minimum="90" Maximum="115" Value="{Binding EmergencyHotspotTemperature}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding EmergencyHotspotTemperature, StringFormat={}{0:F0}°C}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                               Text="Radeon RX 7000 シリーズは Hot Spot 110°C で自動的に性能を下げます。全開の解除は、しきい値より 5°C 下がってからです。"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="このアプリについて" Style="{StaticResource H2}"/>
                                <TextBlock x:Name="AboutText" Style="{StaticResource Caption}" Margin="0,10,0,0" LineHeight="20"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="SettingsAuto" Visibility="Collapsed">
                        <!-- プロファイル -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="＋ 新しいプロファイル" Click="OnNewProfileClick"/>
                                    <StackPanel>
                                        <TextBlock Text="プロファイル" Style="{StaticResource H2}"/>
                                        <TextBlock Text="ファンカーブの組み合わせを名前を付けて保存し、切り替えられます" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </DockPanel>
                                <ItemsControl x:Name="ProfilesList" Margin="0,14,0,0" ItemsSource="{Binding Profiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="190"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding Name}" Margin="0,0,10,0"/>
                                                <ComboBox Grid.Column="1" Margin="0,0,10,0" DisplayMemberPath="Label" SelectedValuePath="Id"
                                                          SelectedValue="{Binding Role}"
                                                          ToolTip="このプロファイルの役割。名前を変えても、おまかせ調整（静音は目標温度 +5°C・冷却重視は −5°C）・新しいファンのカーブ・ワンタッチの「静音」が、この役割で正しく動きます"
                                                          ItemsSource="{Binding ProfileRoleOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                <ComboBox Grid.Column="2" Margin="0,0,10,0" DisplayMemberPath="Name" SelectedValuePath="Guid"
                                                          SelectedValue="{Binding PowerPlanGuid}" ToolTip="このプロファイルのときに使う Windows の電源プラン"
                                                          ItemsSource="{Binding PowerPlanOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                    <Button Style="{StaticResource SmallGhost}" Content="普段使う" Tag="{Binding}" Click="OnUseProfileClick" Margin="0,0,6,0"/>
                                                    <Button Style="{StaticResource SmallGhost}" Content="複製" Tag="{Binding}" Click="OnDuplicateProfileClick" Margin="0,0,6,0"/>
                                                    <Button Style="{StaticResource DangerButton}" Content="削除" Tag="{Binding}" Click="OnDeleteProfileClick" Padding="10,5" FontSize="13"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <CheckBox x:Name="RestorePlanSwitch" Style="{StaticResource Switch}" Margin="0,8,0,0" Click="OnRestorePlanClick">
                                    <StackPanel>
                                        <TextBlock Text="終了時に元の電源プランに戻す" FontWeight="SemiBold"/>
                                        <TextBlock Text="電源プランは、プロファイルが切り替わったときに自動で変わります（「変えない」を選ぶとそのまま）" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <!-- スケジュール -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="＋ ルールを追加" Click="OnAddScheduleClick"/>
                                    <StackPanel>
                                        <TextBlock Text="スケジュール" Style="{StaticResource H2}"/>
                                        <TextBlock Text="時間帯でプロファイルを切り替えます（例: 毎日 23:00〜7:00 は静音）。アプリの自動切り替えのほうが優先されます" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </DockPanel>
                                <ItemsControl x:Name="ScheduleList" Margin="0,14,0,0" ItemsSource="{Binding ScheduleRules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Days}">
                                                    <ComboBoxItem Content="毎日" Tag="Everyday"/>
                                                    <ComboBoxItem Content="平日" Tag="Weekdays"/>
                                                    <ComboBoxItem Content="週末" Tag="Weekends"/>
                                                </ComboBox>
                                                <TextBox Grid.Column="1" Text="{Binding Start}" Margin="8,0,0,0" ToolTip="開始時刻（例: 23:00）"/>
                                                <TextBlock Grid.Column="2" Text="〜" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"/>
                                                <TextBox Grid.Column="3" Text="{Binding End}" ToolTip="終了時刻（例: 7:00）。開始より前なら翌日の時刻"/>
                                                <TextBlock Grid.Column="4" Text="→" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"/>
                                                <ComboBox Grid.Column="5" DisplayMemberPath="Name" SelectedValuePath="Name" SelectedValue="{Binding ProfileName}"
                                                          ItemsSource="{Binding DataContext.Profiles, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                <Button Grid.Column="6" Style="{StaticResource DangerButton}" Content="削除" Tag="{Binding}" Click="OnRemoveScheduleClick"
                                                        Margin="10,0,0,0" Padding="10,5" FontSize="13"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 自動切り替え -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="プロファイルの自動切り替え" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                           Text="指定したアプリが起動している間、プロファイルを自動で切り替えます。上にあるルールほど優先されます。終了すると「普段使う」プロファイルに戻ります。"/>
                                <TextBlock x:Name="AutoSwitchStatus" Style="{StaticResource Caption}" Foreground="{DynamicResource Accent2Brush}" Margin="0,8,0,0"/>
                                <ItemsControl x:Name="RulesList" Margin="0,12,0,0" ItemsSource="{Binding AutoSwitchRules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="44"/>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding ProcessName}"/>
                                                <TextBlock Grid.Column="1" Text="→" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"/>
                                                <ComboBox Grid.Column="2" DisplayMemberPath="Name" SelectedValuePath="Name" SelectedValue="{Binding ProfileName}"
                                                          ItemsSource="{Binding DataContext.Profiles, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                <Button Grid.Column="3" Style="{StaticResource DangerButton}" Content="削除" Tag="{Binding}" Click="OnRemoveRuleClick"
                                                        Margin="10,0,0,0" Padding="10,5" FontSize="13"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Background="{DynamicResource OverlayBrush}" CornerRadius="10" Padding="14" Margin="0,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBox x:Name="NewRuleProcess" ToolTip="プロセス名（例: eldenring）。.exe は付けても付けなくても構いません"/>
                                        <Button Grid.Column="2" Style="{StaticResource SmallGhost}" Content="実行中のアプリから選ぶ ▾" Click="OnPickRunningAppClick"/>
                                        <TextBlock Grid.Column="3" Text="→" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"/>
                                        <ComboBox x:Name="NewRuleProfile" Grid.Column="4" DisplayMemberPath="Name"/>
                                        <Button Grid.Column="5" Style="{StaticResource AccentButton}" Content="追加" Click="OnAddRuleClick" Margin="10,0,0,0"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ワンタッチ操作 -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="ワンタッチ操作" Style="{StaticResource H2}"/>
                                <TextBlock Text="ダッシュボード・タスクトレイ・ミニウィジェット・スマホから、一時的にブースト（全開）や静音にできます" Style="{StaticResource Caption}"/>
                                <CheckBox x:Name="HotkeysSwitch" Style="{StaticResource Switch}" Margin="0,16,0,0" Click="OnHotkeysClick">
                                    <StackPanel>
                                        <TextBlock Text="ホットキーを使う（ゲーム中でも操作できます）" FontWeight="SemiBold"/>
                                        <TextBlock Text="Ctrl+Alt+B: 5 分ブースト ／ Ctrl+Alt+Q: 1 時間静音 ／ Ctrl+Alt+N: 解除" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </CheckBox>
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="「静音」で使うプロファイル" Style="{StaticResource Label}"/>
                                    <ComboBox x:Name="QuietProfileCombo" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="OnQuietProfileChanged"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="SettingsLink" Visibility="Collapsed">
                        <!-- スマホから監視 -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="スマホから監視" Style="{StaticResource H2}"/>
                                <CheckBox x:Name="WebSwitch" Style="{StaticResource Switch}" Margin="0,16,0,0" Click="OnWebSwitchClick">
                                    <StackPanel>
                                        <TextBlock Text="スマホのブラウザから見られるようにする" FontWeight="SemiBold"/>
                                        <TextBlock Text="同じ Wi-Fi のスマホから温度・回転数の確認とプロファイルの切り替えができます。Windows ファイアウォールに、プライベートネットワーク（自宅など）だけの許可を追加します" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </CheckBox>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ポート番号" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="WebPortBox" Grid.Column="1" LostFocus="OnWebPortChanged"/>
                                    <Button Grid.Column="2" Style="{StaticResource SmallGhost}" Content="アクセス用の鍵を作り直す" Click="OnRegenerateTokenClick"
                                            HorizontalAlignment="Left" Margin="12,0,0,0" ToolTip="今までの URL では開けなくなります"/>
                                </Grid>
                                <Grid x:Name="WebInfoPanel" Margin="0,14,0,0" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="White" CornerRadius="8" Padding="6">
                                        <Image x:Name="WebQr" Width="150" Height="150" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                        <TextBlock Text="スマホのカメラで QR コードを読むか、次の URL を開いてください" Style="{StaticResource Caption}"/>
                                        <TextBox x:Name="WebUrls" IsReadOnly="True" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="13" VerticalContentAlignment="Top"/>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Foreground="{DynamicResource WarnBrush}"
                                                   Text="URL にはアクセス用の鍵が含まれています。他の人に教えないでください"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- スマホに通知 -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="スマホに通知" Style="{StaticResource H2}"/>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Notify.Enabled}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="緊急全開・ポンプ異常・ファンの停止などをスマホに通知する" FontWeight="SemiBold"/>
                                        <TextBlock Text="外出中やゲーム中でも気づけます。同じ内容の通知は 10 分間は送りません" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </CheckBox>
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="NotifyService" Content="ntfy（アプリを入れるだけ・おすすめ）"
                                                 IsChecked="{Binding Notify.Service, Converter={StaticResource Equals}, ConverterParameter=Ntfy}"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="NotifyService" Content="Discord"
                                                 IsChecked="{Binding Notify.Service, Converter={StaticResource Equals}, ConverterParameter=Discord}"/>
                                </StackPanel>

                                <Grid Style="{StaticResource NtfyOnly}" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="White" CornerRadius="8" Padding="6" VerticalAlignment="Top">
                                        <Image x:Name="NtfyQr" Width="120" Height="120" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="20"
                                                   Text="1. スマホに「ntfy」アプリを入れる（App Store / Google Play・無料・登録不要）&#10;2. アプリの「＋」から、下のトピック名を購読する（左の QR コードをカメラで読んでも OK）"/>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="38"/>
                                                <RowDefinition Height="38"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="トピック名" Style="{StaticResource Label}"/>
                                            <TextBox Grid.Column="1" Text="{Binding Notify.NtfyTopic}" LostFocus="OnNotifySettingLostFocus"/>
                                            <Button Grid.Column="2" Style="{StaticResource SmallGhost}" Content="作り直す" Click="OnNewTopicClick" Margin="8,0,0,0"/>
                                            <TextBlock Grid.Row="1" Text="サーバー" Style="{StaticResource Label}"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Notify.NtfyServer}" LostFocus="OnNotifySettingLostFocus"/>
                                        </Grid>
                                        <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource WarnBrush}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Text="トピック名を知っている人は誰でも通知を読めます。推測されにくい今の名前のまま使ってください"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Style="{StaticResource DiscordOnly}" Margin="0,14,0,0">
                                    <TextBlock Text="Webhook URL" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding Notify.DiscordWebhook}"/>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="Discord のサーバー設定 →「連携サービス」→「ウェブフック」→「新しいウェブフック」→「ウェブフック URL をコピー」で取得できます"/>
                                </StackPanel>

                                <WrapPanel Margin="0,14,0,0">
                                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Notify.IncludeWarnings}" Margin="0,4,24,4"
                                              Content="「注意」も通知する（ファンの停止・センサーの異常など）"/>
                                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Notify.IncludeRecovery}" Margin="0,4,24,4"
                                              Content="回復したときも通知する"/>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource GhostButton}" Content="テスト送信" Click="OnTestNotifyClick"/>
                                    <TextBlock x:Name="NotifyStatus" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- LED のライティング（左のメニューの「ライティング」に移動） -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="ライティングを開く" Click="OnOpenLightingClick"
                                        VerticalAlignment="Center" Margin="16,0,0,0" ToolTip="LED のライティング（OpenRGB 連携）の画面を開きます"/>
                                <StackPanel>
                                    <TextBlock Text="LED のライティング（OpenRGB 連携）" Style="{StaticResource H2}"/>
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                               Text="LED の設定は、左のメニューの「ライティング」に移りました。接続・光り方・音楽連動・デバイスごとの設定をまとめて変えられます。"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 電気代 -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="電気代の計算" Style="{StaticResource H2}"/>
                                <TextBlock Text="ダッシュボードとレポート画面に、消費電力量と電気代の目安を表示します" Style="{StaticResource Caption}"/>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="40"/>
                                        <RowDefinition Height="40"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="1 kWh あたりの電気代" Style="{StaticResource Label}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Energy.PricePerKwh}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center"
                                               Text="円（検針票の単価。分からなければ目安の 31 円のまま）"/>
                                    <TextBlock Grid.Row="1" Text="CPU・GPU 以外の消費電力" Style="{StaticResource Label}"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Energy.BaseWatts}" TextAlignment="Right"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center"
                                               Text="W（マザーボード・メモリ・SSD・ファン・電源の損失など。一般的に 40〜80 W）"/>
                                </Grid>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Text="CPU と GPU はセンサーの値を使います。モニターやスピーカーは含みません。コンセントで測った値ではないので、あくまで目安です。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="SettingsSafety" Visibility="Collapsed">
                        <!-- 安全機能 -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="安全機能" Style="{StaticResource H2}"/>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Safety.WatchdogEnabled}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="見張りプロセスを使う（おすすめ）" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                   Text="アプリが強制終了・フリーズしたとき、ファンが低い回転のまま止まってしまうのを防ぎます。タスクマネージャーに ProFanController が 2 つ表示されますが、片方は見張り役です"/>
                                    </StackPanel>
                                </CheckBox>
                                <Grid Margin="52,12,0,0" IsEnabled="{Binding Safety.WatchdogEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="そのときの回転数" Style="{StaticResource Label}" ToolTip="ポンプは常に 100% にします"/>
                                    <Slider Grid.Column="1" Minimum="40" Maximum="100" Value="{Binding Safety.WatchdogSafeDuty}" IsSnapToTickEnabled="True" TickFrequency="5"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Safety.WatchdogSafeDuty, StringFormat={}{0:F0}%}"/>
                                    <CheckBox Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Check}" IsChecked="{Binding Safety.WatchdogRestart}" Margin="0,6,0,0"
                                              Content="アプリを自動で起動し直す（10 分間に 3 回までで、それ以上はお知らせを表示）"/>
                                </Grid>

                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Safety.SensorFilterEnabled}" Margin="0,20,0,0">
                                    <StackPanel>
                                        <TextBlock Text="異常なセンサーの値を無視する" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                   Text="一瞬だけ跳ねた値（読み取りエラー）で全開にならないようにします。負荷が変わっても値が動かない「固まった」センサーは、異常として扱います"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Safety.HardwareCheckEnabled}" Margin="0,20,0,0">
                                    <StackPanel>
                                        <TextBlock Text="起動時に部品の交換を確認する" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                   Text="GPU などを交換してセンサーが変わったときに、新しいセンサーへの置き換えを案内します"/>
                                    </StackPanel>
                                </CheckBox>
                                <Grid Margin="52,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="センサーがないときの回転数" Style="{StaticResource Label}"/>
                                    <Slider Grid.Column="1" Minimum="30" Maximum="100" Value="{Binding Safety.MissingSensorDuty}" IsSnapToTickEnabled="True" TickFrequency="5"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Safety.MissingSensorDuty, StringFormat={}{0:F0}%}"/>
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                               Text="部品を外した・交換したなどで、センサーそのものが見つからないカーブはこの回転数にします（センサーはあるのに値がおかしいときは、安全のため 100%）"/>
                                </Grid>

                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Safety.FlightRecorderEnabled}" Margin="0,20,0,0">
                                    <StackPanel>
                                        <TextBlock Text="異常の前後を自動で記録する" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource Caption}" Text="緊急全開・ポンプ異常などのとき、前後 10 分の記録を保存します（レポート画面で確認できます）"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Safety.AllowGpuFanControl}" Margin="0,20,0,0">
                                    <StackPanel>
                                        <TextBlock Text="GPU のファンも制御できるようにする（試験的）" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                   Text="ファンカーブ画面の「端子を追加」に GPU のファンが表示されます。制御中は GPU ドライバーの自動制御（0 RPM モードなど）が止まるので、GPU の温度を使ったカーブで使ってください"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Safety.ReadMemoryTemperature}" Margin="0,20,0,0">
                                    <StackPanel>
                                        <TextBlock Text="メモリの温度を読む" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                   Text="メモリの温度は、メモリの LED と同じ配線（SMBus）で読みます。OpenRGB などがこの配線を順番待ちせずに使っていると、ぶつかってメモリの温度が読めなくなることがあります。そのときはオフにしてください（メモリの温度を使うカーブは、センサーが見つからないときの回転数で回ります）"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <!-- バックアップと共有 -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="設定のバックアップと共有" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Text="設定は変更のたびに自動でバックアップしています（10 分に 1 回まで・最大 30 個）。config.json が壊れても、起動時に自動で復旧します。プロファイルをファイルに書き出せば、別の PC で読み込めます（端子やセンサーは名前で対応付けます）"/>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Style="{StaticResource AccentButton}" Content="設定を書き出す…" Click="OnExportSettingsClick" Margin="0,0,8,8"/>
                                    <Button Style="{StaticResource GhostButton}" Content="設定を読み込む…" Click="OnImportSettingsClick" Margin="0,0,8,8"/>
                                    <Button x:Name="RestoreBackupButton" Style="{StaticResource GhostButton}" Content="バックアップから戻す ▾" Click="OnRestoreBackupClick" Margin="0,0,8,8"/>
                                    <Button Style="{StaticResource GhostButton}" Content="今すぐバックアップ" Click="OnBackupNowClick" Margin="0,0,8,8"/>
                                </WrapPanel>
                                <TextBlock x:Name="BackupInfo" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </Border>

                        <!-- セットアップ・ファイル -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="セットアップとファイル" Style="{StaticResource H2}"/>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Style="{StaticResource AccentButton}" Content="セットアップウィザードを開く" Click="OnOpenWizardClick" Margin="0,0,8,8"/>
                                    <Button Style="{StaticResource GhostButton}" Content="設定フォルダを開く" Click="OnOpenFolderClick" Margin="0,0,8,8"/>
                                    <Button Style="{StaticResource GhostButton}" Content="ログフォルダを開く" Click="OnOpenLogsClick" Margin="0,0,8,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- ファン制御用のドライバー（PawnIO）: ないときは、ここからインストールできる（MainWindow.Setup.cs） -->
                        <Border x:Name="PawnIoCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="ファン制御用のドライバー（PawnIO）" Style="{StaticResource H2}"/>
                                <ui:PawnIoInstallPanel x:Name="PawnIoPanel" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- アンインストール（お片付け）（MainWindow.Setup.cs ・ App.Uninstall.cs） -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="アンインストール（お片付け）" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="20"
                                           Text="このアプリを使うのをやめるときに使います。ファンを BIOS の自動制御に戻したことを確かめてから、ライティングの制御・ログオン時の自動起動・ファイアウォールの許可などを片付けて終了します。何を行うかは、次の画面で確かめてから始められます（設定・記録を消すか、PawnIO もアンインストールするかも選べます）"/>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button x:Name="CleanUninstallButton" Style="{StaticResource DangerButton}" Content="アンインストール（お片付け）…" Click="OnCleanUninstallClick" Margin="0,0,8,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
