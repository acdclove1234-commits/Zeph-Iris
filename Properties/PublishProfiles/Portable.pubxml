<?xml version="1.0" encoding="utf-8"?>
<!-- ==================================================
     Portable.pubxml - .NET ランタイムごと exe 1 ファイルに入れる（.NET が入っていない PC でも動く・約 180MB）
     使い方: dotnet publish -p:PublishProfile=Portable
     ================================================== -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF のネイティブ DLL も exe の中に入れる -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 圧縮しない: 圧縮すると、起動時に部品（DLL）をすべてアプリ専用のメモリへ展開するため、常に約 60MB（使用中のメモリは約 100MB）多く使っていた。
         圧縮しなければ exe から直接読み込む（Windows がファイルとして扱う）。exe は大きくなるが、インストーラーが圧縮するので配るファイルの大きさはほぼ同じ -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>C:\Tools\Zeph-Iris-Portable\</PublishDir>
  </PropertyGroup>
</Project>
