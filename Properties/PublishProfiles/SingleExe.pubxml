<?xml version="1.0" encoding="utf-8"?>
<!-- ==================================================
     SingleExe.pubxml - exe 1 ファイルに発行する（.NET 8 デスクトップランタイムが入っている PC 用・軽量）
     使い方: dotnet publish -p:PublishProfile=SingleExe
     ================================================== -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- LHM が連れてくる補助 DLL も exe の中に入れて、exe 1 つにする -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- pdb（デバッグ情報）を出さず、exe だけにする -->
    <DebugType>none</DebugType>
    <PublishDir>bin/publish-single/</PublishDir>
  </PropertyGroup>
</Project>
